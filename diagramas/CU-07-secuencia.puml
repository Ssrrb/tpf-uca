@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-07 · Registrar gasto de obra
actor "Administrador\n(o Ingeniero de obra\nen caja chica, 1a)" as Usr
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
participant "proveedor:\nProveedor" as Prov
participant "persona:\nPersona" as Pers
end box
box "Motor de finanzas" #EAF2F6
participant "gasto:\nGasto" as G
participant "imputacion:\nImputacion" as Imp
participant "comprobante:\nComprobante" as Comp
participant "costo:\nCostoReal" as CR
end box
box "ECMS" #EAF2F6
participant "vigente:\nVersionCostos" as VC
end box

Usr -> Obra: permiteGastos()
Obra --> Usr: permitido: lógico
create G
Usr -> G: «create»(obra, tipo, importe, fecha, medio, actor)
alt material o caja chica con proveedor
  G -> Prov: estaActivo()
  Prov --> G: activo: lógico
else mano de obra propia
  G -> Pers: estaActiva()
  Pers --> G: activa: lógico
end
opt compra de materiales
  Usr -> G: indicarInsumo(insumo, cantidad)
end
loop por cada rubro al que se imputa (3a: varios rubros)
  Usr -> G: imputar(rubro, ítem, importe)
  G -> VC: obtenerRubro(código)
  VC --> G: rubro [0..1]
  alt rubro de la versión vigente
    create Imp
    G -> Imp: «create»(rubro, importe)
  else gasto que no es de un rubro en particular (3b)
    G -> VC: rubroGastosGenerales()
    VC --> G: "Gastos generales de obra"
    G -> Imp: «create»(gastos generales, importe)
  else rubro inexistente en la vigente (3b)
    G --> Usr: impide imputar
  end
end
Usr -> G: adjuntarComprobante(archivo)
create Comp
G -> Comp: «create»(tipo, archivo)
G -> G: validarImporte()
opt gasto de caja chica (1a, RF-21)
  G -> Obra: obtenerTopeCajaChica()
  Obra --> G: tope
  break el importe supera el tope y lo registra el Ingeniero
    G --> Usr: no permite confirmar; lo registra el Administrador
  end
end
Usr -> G: confirmar(actor)
break falta el comprobante (6a)
  G --> Usr: marca el campo e impide confirmar (vuelve al paso 4)
end
loop por cada imputación
  G -> CR: sumar(importe)
end
G --> Usr: gasto registrado; suma al costo real del rubro (RF-21)
@enduml
