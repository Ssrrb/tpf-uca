@startuml
!theme plain
skinparam style strictuml
hide circle
hide empty members
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam nodesep 35
skinparam ranksep 45
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-10 · Controlar costos y Curva S de la obra

class "Motor de ingeniería" as MotorIngenieria <<control>> {
  --
  + consultarCostos(obra: Obra, fechaCorte: fecha): ConsultaCostos
  + filtrar(consulta: ConsultaCostos, rubro: texto, ejecutor: texto): vacío
  + verOrigen(linea: LineaCosto): lista de respaldo
  + exportar(consulta: ConsultaCostos, formato: XLSX | PDF): archivo
}

class Obra {
  + identificador: identificador
  + codigo: texto
  --
  + perteneceUsuario(usuarioId: identificador): lógico
  + obtenerPresupuestoCostosVigente(): VersionPresupuestoCostos
  + obtenerMedicionesAprobadas(fechaCorte: fecha): lista de MedicionAvance
  + obtenerVersionesCertificado(fechaCorte: fecha): lista de VersionCertificado
}

class "Versión de presupuesto de costos" as VersionPresupuestoCostos {
  + numero: entero
  --
  + obtenerItems(): lista de ItemPresupuesto
}

class "Ítem de presupuesto" as ItemPresupuesto {
  + rubro: texto
  + descripcion: texto
  + cantidadPresupuestada: decimal
  + costoUnitario: decimal
  --
  + costoPresupuestado(): decimal
}

class "Medición de avance" as MedicionAvance {
  + cantidad: decimal
  + ejecutor: propio | subcontratado
  + fecha: fecha
  + cantidadExcedidaPendiente: decimal
  --
  + costoReal(): decimal
}

class "Versión de certificado" as VersionCertificado {
  + numeroVersion: entero
  + fecha: fecha
  --
  + importeCertificadoHasta(fechaCorte: fecha): decimal
}

class "Consulta de costos" as ConsultaCostos {
  + fechaCorte: fecha
  + moneda: texto = "PYG"
  + filtroRubro: texto [0..1]
  + filtroEjecutor: propio | subcontratista [0..1]
  --
  + agregarLinea(linea: LineaCosto): vacío
  + aplicarFiltro(rubro: texto, ejecutor: texto): vacío
  + estaVacia(): lógico
  + exportar(formato: XLSX | PDF): archivo
}

class "Línea de costo" as LineaCosto {
  + rubro: texto
  + item: texto
  + costoPresupuestado: decimal
  + costoReal: decimal
  + /diferencia: decimal
  + /saldo: decimal
  + origenes: lista de respaldo
  --
  + obtenerOrigen(): lista de respaldo
}

class "Curva S" as CurvaS {
  + fechaCorte: fecha
  + avanceFisico: lista de puntos
  + avanceFinanciero: lista de puntos
  + fisicoPendienteAdenda: lista de puntos
  --
  + calcular(mediciones: lista de MedicionAvance, versiones: lista de VersionCertificado): vacío
}

MotorIngenieria ..> Obra : consulta
MotorIngenieria ..> ConsultaCostos : genera
Obra "1" *-- "1..*" VersionPresupuestoCostos : versiones de costos
VersionPresupuestoCostos "1" *-- "1..*" ItemPresupuesto : contiene
Obra "1" *-- "0..*" MedicionAvance : registra
MedicionAvance "0..*" --> "1" ItemPresupuesto : mide
Obra "1" *-- "0..*" VersionCertificado : versiones del certificado
ConsultaCostos "0..*" --> "1" Obra : de
ConsultaCostos "1" *-- "0..*" LineaCosto : contiene
ConsultaCostos "1" *-- "1" CurvaS : dibuja
LineaCosto "0..*" --> "1" ItemPresupuesto : costea

note bottom of LineaCosto
  costoReal suma lo propio (consumos de la medición)
  y lo subcontratado. origenes guarda las mediciones,
  versiones del certificado o documentos usados (NF-12).
end note
@enduml
