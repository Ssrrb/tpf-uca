@startuml
!theme plain
skinparam style strictuml
title CU-10 · Controlar el costo de la obra con el ACU
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Control de costos" as ControlCostos {
    fechaConsulta: fecha
    filtro: rubro | ejecutor | tipo de gasto [0..1]
    --
    + consultar(obra, fechaConsulta): lista de LíneaControl
    + filtrar(criterio): vacío
    + verRespaldo(total): lista de archivo
  }

  class "Línea de control" as LineaControl {
    costoPresupuestado: guaraníes
    consumidoACU: guaraníes
    liquidadoSubcontratos: guaraníes
    compradoGastos: guaraníes
    acopioMateriales: guaraníes
    desvíoManoObraEquipos: guaraníes
    /diferencia: guaraníes
    /saldo: guaraníes
  }

  class "Versión del presupuesto de costos" as VersionCostos {
    estado: EstadoVersionCostos
    --
    + obtenerÍtems(): lista de ÍtemCostos
  }

  class "Apartado Adendas" as ApartadoAdendas {
    --
    + costoPorÍtem(ítem): guaraníes
  }

  class "Ítem de costos" as ItemCostos {
    ejecutor: propio | subcontratista
    --
    + calcularCostoPresupuestado(): guaraníes
  }

  class "Análisis de costo unitario" as ACU {
    --
    + costoConsumido(consumos, fecha): guaraníes
  }

  class "Medición" as Medicion {
    fechaEjecución: fecha
    --
    + consumosHasta(fecha): lista de ConsumoInsumo
    + verEvidencia(): lista de Evidencia
  }
}

package "Motor de finanzas" {
  class "Consulta de costos reales" as CostosReales {
    --
    + gastosPorRubro(obra, fecha): lista de Gasto
    + liquidacionesHasta(obra, fecha): lista de Liquidación
  }

  class Gasto {
    fechaComprobante: fecha
    importe: guaraníes
    --
    + verComprobante(): Comprobante
  }
}

package "ERP" {
  class Insumo {
    --
    + obtenerPrecioVigente(fecha): guaraníes [0..1]
  }
}

ControlCostos "1" *-- "0..*" LineaControl : por rubro e ítem
ControlCostos ..> VersionCostos : usa
ControlCostos ..> ApartadoAdendas : usa
ControlCostos ..> Medicion : usa
ControlCostos ..> CostosReales : usa
VersionCostos "1" *-- "1..*" ItemCostos : contiene
ItemCostos "1" *-- "0..1" ACU : análisis
Medicion "0..*" --> "1" ItemCostos : mide
ACU ..> Insumo : precios
CostosReales ..> Gasto : consulta
LineaControl "0..*" --> "1" ItemCostos : de

note bottom of LineaControl
  Materiales: comprado - consumido = acopio, no mayor costo.
  Mano de obra y equipos: la diferencia es desvío (RF-17).
  La consulta no modifica ni cierra nada.
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
