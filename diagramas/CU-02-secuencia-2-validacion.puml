@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-02 · 2/3 · Estructura y validación
actor "Ingeniero de obra" as Ing
box "ECMS" #EAF2F6
participant "presupuesto:\nPresupuestoCliente" as Pres
participant "hoja:\nHoja" as Hoja
participant "columna:\nColumna" as Col
participant "informe:\nInformeImportacion" as Inf
end box

Pres -> Pres: identificarEstructura()
alt estructura identificada
  Pres --> Ing: hojas, columnas y relaciones entre rubros e ítems (RF-03)
else no se identifica la estructura (3a)
  loop por cada columna que falta definir
    Ing -> Hoja: definirColumna(índice, campo)
  end
end
Ing -> Pres: confirmarEstructura()
note right of Ing
  Confirma rubros, unidades
  y agrupaciones (paso 4).
end note
Pres -> Pres: validarDatos()
create Inf
Pres -> Inf: «create»(fecha)
loop por cada hoja
  Pres -> Hoja: validarFilas(informe)
  loop por cada fila y columna obligatoria
    Hoja -> Col: validarValor(valor)
    Col --> Hoja: válido: lógico
    opt valor inválido
      Hoja -> Inf: registrarError(hoja, fila, columna, motivo)
    end
  end
end
break hay datos inválidos (5a)
  Pres --> Ing: cada error con hoja, fila y columna; corrige y recarga o cancela
end
ref over Ing, Inf
  Continúa en 3/3: totales y finalización.
end ref
@enduml
