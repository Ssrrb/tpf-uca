@startuml
!theme plain
skinparam style strictuml
title CU-08 · Generar factura interna del certificado
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "Motor de finanzas" {
  class "Facturación interna" as Facturacion {
    --
    + listarPendientes(obra): lista
    + generarFactura(versión, actor): DocumentoInterno
    + generarFacturaAnticipo(anticipo, actor): FacturaInterna
  }

  enum EstadoDocumento {
    generada
    pendiente_de_adjuntar
    a_cobrar
    cobrada_parcial
    cobrada
  }

  abstract class "Documento interno" as DocumentoInterno {
    número: entero
    moneda: texto = PYG
    neto: guaraníes
    iva: guaraníes
    /total: guaraníes
    sinValidezFiscal: lógico = verdadero
    estado: EstadoDocumento
    motivoDiferencia: texto [0..1]
    --
    + adjuntarFacturaLegal(número, fecha, importe, archivo): vacío
    + compararConLegal(): guaraníes
    + registrarMotivoDiferencia(motivo): vacío
    + confirmar(actor): vacío
  }

  class "Factura interna" as FacturaInterna
  class "Nota de crédito interna" as NotaCreditoInterna

  class "Factura legal" as FacturaLegal {
    número: texto
    fecha: fecha
    importe: guaraníes
    archivo: archivo
  }

  class "Cuenta a cobrar" as CuentaACobrar {
    saldoPendiente: guaraníes
  }
}

package "ECMS" {
  class "Versión del certificado" as VersionCertificado {
    neto: guaraníes
    iva: guaraníes
    --
    + importeSinFacturar(): guaraníes
  }
}

package "ERP" {
  class Obra {
    --
    + datosCliente(): Cliente [0..1]
  }

  class Anticipo {
    importe: guaraníes
    facturado: lógico
    --
    + marcarFacturado(): vacío
  }

  class Cliente {
    razónSocial: texto
    ruc: texto
  }
}

DocumentoInterno <|-- FacturaInterna
DocumentoInterno <|-- NotaCreditoInterna
DocumentoInterno "0..*" --> "0..1" VersionCertificado : corresponde a
FacturaInterna "0..1" --> "0..1" Anticipo : factura
DocumentoInterno "1" *-- "0..1" FacturaLegal : adjunta
DocumentoInterno "1" *-- "1" CuentaACobrar : registra
DocumentoInterno "0..*" --> "1" Obra : de la obra
Obra "0..*" --> "1" Cliente : cliente
Facturacion ..> DocumentoInterno : genera

note bottom of DocumentoInterno
  Toma el neto y el IVA de la versión sin recalcularlos (RF-14).
  Sin crédito fiscal ni validez ante Marangatu:
  la factura legal se emite fuera de Ctrl+.
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
