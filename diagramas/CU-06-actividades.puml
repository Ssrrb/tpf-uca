@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-06 · Actividades · Generar versión del certificado de avance
|Ingeniero de obra|
start
:Seleccionar la obra y generar la versión siguiente;
|ECMS|
if (¿La obra está en ejecución?) then ([no])
  :Informar que no se generan versiones;
  stop
else ([sí])
endif
|Ingeniero de obra|
if (¿Hay un error en una versión guardada?) then ([sí])
  :Agregar líneas de ajuste con motivo,
  vinculadas a la versión que corrigen (RN-06);
else ([no])
endif
|ECMS|
:Tomar las cantidades medidas no certificadas,
los ajustes y lo cubierto por adendas;
:Excluir lo que supera el saldo contractual sin adenda;
:Valorizar con el precio del presupuesto
del cliente o del de adendas (RF-13);
if (¿Algún ítem no tiene precio unitario?) then ([sí])
  :Señalarlo con su dato de origen
  e impedir confirmar hasta corregirlo;
  stop
else ([no])
endif
:Calcular bruto, amortización del anticipo,
fondo de reparo, neto e IVA (RN-08);
:Señalar excesos, faltantes, precios sin movimiento,
diferencias y mayores costos (RF-15);
|Ingeniero de obra|
:Revisar la versión y los señalamientos;
:Confirmar;
|ECMS|
:Guardar la versión con sus respaldos y vínculos;
|Ingeniero de obra|
if (¿Exportar?) then ([sí])
  :Exportar como XLSX o PDF de uso interno;
else ([no])
endif
stop
@enduml
