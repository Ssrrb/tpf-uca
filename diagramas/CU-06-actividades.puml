@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-06 · Actividades · Calcular el certificado y el consumo de recursos
|Ingeniero de obra|
start
:Elegir la versión con las cantidades cerradas (CU-04);
|Ctrl+ · Motor de finanzas|
if (¿La obra está en ejecución y la versión cerrada?) then ([no])
  :Informar por qué no se puede calcular;
  stop
else ([sí])
endif
:Agregar líneas de regularización por las adendas
registradas desde la versión anterior (RF-08);
:Valorizar cada línea con el precio del presupuesto
del cliente o del ítem de adenda (RF-10);
if (¿Algún ítem no tiene precio unitario?) then ([sí])
  :Señalarlo e impedir confirmar;
  stop
else ([no])
endif
:Comparar por ítem el monto acumulado con el del
cliente más las adendas registradas (RF-08);
if (¿Algún ítem supera ese monto?) then ([sí])
  :Señalar la línea en exceso como saldo negativo,
  fuera del bruto;
  note right
    Se puede registrar una adenda (CU-11).
  end note
else ([no])
endif
:Calcular bruto, amortización del anticipo,
fondo de reparo, neto e IVA (RF-10);
|Ctrl+ · ERP|
:Calcular el consumo de insumos de las mediciones
incluidas, al precio vigente (RF-24);
|Ingeniero de obra|
:Revisar y confirmar;
|Ctrl+ · Motor de finanzas|
:Guardar la versión valorizada;
|Ctrl+ · ERP|
:Registrar el consumo de insumos;
note right
  Se guarda todo junto o nada (NF-02).
end note
stop
@enduml
