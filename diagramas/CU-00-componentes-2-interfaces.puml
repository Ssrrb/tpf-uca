@startuml
!theme plain
skinparam style strictuml
title Componentes · Interfaces entre los subsistemas de Ctrl+
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #17324D
skinparam nodesep 35
skinparam ranksep 55
skinparam component {
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam interface {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}

package "Motor de finanzas" {
  component "Liquidaciones" <<subsistema>> as LIQ
  component "Certificación" <<subsistema>> as CER
  interface "ICertificados" as ICER
}

package "ECMS" {
  component "Avance" <<subsistema>> as AVA
  interface "IMediciones" as IAVA
  component "Subcontratos" <<subsistema>> as SUB
  interface "IContratos" as ISUB
  component "Incidencias" <<subsistema>> as INC
  component "Estructura de trabajo" <<subsistema>> as EST
  interface "IEstructuraDeTrabajo" as IEST
  component "Presupuesto del cliente" <<subsistema>> as PRE
  interface "IPresupuestoDelCliente" as IPRE
  component "Modelos BIM" <<subsistema>> as MOD
  interface "IModelos" as IMOD
  interface "IObservadorDeModelo" as IOBS
  component "Documentación" <<subsistema>> as DOC
  interface "IDocumentos" as IDOC
}

package "ERP" {
  component "Obras" <<subsistema>> as OBR
  interface "IObras" as IOBR
  interface "IPrepararCarpetaDeObra" as ICAR
  component "Catálogos" <<subsistema>> as CAT
  interface "ICatálogos" as ICAT
  component "Organización y acceso" <<subsistema>> as ACC
  interface "IControlDeAcceso" as IACC
}

CER -down- ICER
AVA -down- IAVA
SUB -down- ISUB
EST -down- IEST
PRE -down- IPRE
MOD -down- IMOD
DOC -down- IDOC
OBR -down- IOBR
CAT -down- ICAT
ACC -down- IACC

LIQ -down-( ICER
LIQ -down-( ISUB
CER -down-( IAVA
CER -down-( IPRE
CER -down-( IOBR
AVA -down-( ISUB
AVA -down-( IEST
SUB -down-( IEST
SUB -down-( ICAT
INC -down-( IMOD
INC -down-( IDOC
INC -down-( IEST
EST -down-( IPRE
EST -down-( IMOD
EST -down-( IDOC
PRE -down-( IOBR
MOD -down-( IDOC
DOC -down-( IOBR
OBR -down-( ICAT
OBR -down-( IACC
CAT -down-( IACC

OBR -up-( ICAR
DOC .down.|> ICAR
MOD -up-( IOBS
INC .down.|> IOBS
EST .down.|> IOBS

note bottom of IACC
  Todos los subsistemas requieren IControlDeAcceso
  (NF-01); se dibuja solo desde Obras y Catálogos.
end note

legend bottom
  Círculo = interfaz provista; semicírculo = interfaz requerida (UML 2).
  Línea discontinua con triángulo hueco = realización: Documentación realiza
  IPrepararCarpetaDeObra, que define Obras; Incidencias y Estructura de trabajo
  realizan IObservadorDeModelo, que define Modelos BIM. Así no hay ciclos.
endlegend
@enduml
