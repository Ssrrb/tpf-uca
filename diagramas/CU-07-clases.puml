@startuml
!theme plain
skinparam style strictuml
title CU-07 · Registrar gasto de obra
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "Motor de finanzas" {
  class Gasto {
    tipo: texto {material | mano de obra | caja chica}
    importe: guaraníes
    fecha: fecha
    medioPago: texto
    insumo: Insumo [0..1]
    cantidad: decimal [0..1]
    registradoPor: Usuario
    fechaRegistro: fecha y hora
    --
    + indicarInsumo(insumo, cantidad): vacío
    + imputar(rubro, ítem, importe): vacío
    + adjuntarComprobante(archivo): vacío
    + validarImporte(): lógico
    + confirmar(actor): vacío
  }

  class "Imputación" as Imputacion {
    rubro: texto
    importe: guaraníes
  }

  class Comprobante {
    tipo: factura | planilla | ticket | recibo | comprobante | retención
    archivo: archivo
  }

  class "Costo real del rubro" as CostoReal {
    rubro: texto
    total: guaraníes
    --
    + sumar(importe): vacío
  }
}

package "ECMS" {
  class "Versión del presupuesto de costos" as VersionCostos {
    estado: EstadoVersionCostos
    --
    + obtenerRubro(código): texto [0..1]
    + rubroGastosGenerales(): texto
  }
}

package "ERP" {
  class Obra {
    topeCajaChica: guaraníes
    --
    + permiteGastos(): lógico
    + obtenerTopeCajaChica(): guaraníes
  }

  class Proveedor {
    --
    + estaActivo(): lógico
  }

  class "Persona (RRHH)" as Persona {
    --
    + estaActiva(): lógico
  }
}

Gasto "0..*" --> "1" Obra : de la obra
Gasto "0..*" --> "0..1" Proveedor : pagado a
Gasto "0..*" --> "0..1" Persona : pagado a
Gasto "1" *-- "1..*" Imputacion : se reparte en
Imputacion "0..*" --> "1" VersionCostos : rubro de la vigente
Gasto "1" *-- "1" Comprobante : respaldo
Imputacion "0..*" --> "1" CostoReal : suma al

note bottom of Gasto
  Caja chica: no supera el tope de la obra;
  por encima lo registra el Administrador (RF-21).
  El presupuesto de costos no cambia.
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
