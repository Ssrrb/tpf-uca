@startuml
!theme plain
skinparam style strictuml
title CU-07 · Medir el avance del certificado
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Ítem" as Item {
    código: texto {estable}
    unidad: texto
    --
    + obtenerSaldo(): SaldoItem
  }

  class "Saldo del ítem" as SaldoItem {
    cantidadCliente: decimal
    asignadaAContratos: decimal
    medida: decimal
    certificada: decimal
    liquidada: decimal
    /saldoContractual: decimal
    --
    + saldoContractual(): decimal
    + estaContada(cantidad, medición): lógico
    + registrarMedición(cantidad): vacío
    + revertirMedición(cantidad): vacío
    + cantidadCertificable(): decimal
  }

  class "Medición" as Medicion {
    cantidad: decimal
    unidad: texto
    ejecutor: propio | subcontratado
    estado: EstadoMedicion
    motivo: texto [0..1]
    insumosConsumidos: lista de texto [0..*]
    registradaPor: Usuario
    fecha: fecha y hora
    --
    + corregirInsumo(insumo, cantidad): vacío
    + adjuntarEvidencia(archivo): vacío
    + apuntarAElementos(ítem, elementos): vacío
    + validarCompleta(): lista de texto
    + confirmar(actor): vacío
    + anular(motivo, actor): vacío
    + puedeAnularse(): lógico
    + registrarAjuste(cantidad, motivo, actor): MedicionAjuste
    + incluirEn(versión): vacío
  }

  class "Medición de ajuste" as MedicionAjuste {
    signo: positivo | negativo
  }

  class "Archivo adjunto" as ArchivoAdjunto {
    tipo: foto | archivo
    archivo: Archivo {no se elimina}
  }

  class "Vínculo de la estructura" as VinculoEstructura {
    cantidadConfirmada: decimal
    cantidadSugerida: decimal
    --
    + estaVinculado(ítem, elemento): lógico
  }

  class "Elemento del modelo" as ElementoModelo {
    modelo: texto
    versión: entero
    globalId: texto
  }

  class "Certificado" as Certificado {
    --
    + generarVersiónSiguiente(actor): VersionCertificado
  }

  class "Versión del certificado" as VersionCertificado {
    número: entero
    estado: EstadoVersionCertificado
    --
    + tomarCantidades(): vacío
    + cerrarCantidades(actor): vacío
  }

  enum EstadoVersionCertificado <<enumeration>> {
    abierta
    cantidades_cerradas
    guardada
  }

  class "Línea del certificado" as LineaCertificado {
    tipo: cantidad | ajuste | regularización
    avanceAnterior: decimal
    cantidad: decimal
    /acumulado: decimal
  }

  enum EstadoMedicion <<enumeration>> {
    en_carga
    registrada
    incluida_en_una_version
    certificada
    anulada
  }
}

package "ERP" {
  class Obra {
    estado: EstadoObra
    --
    + permiteMediciones(): lógico
  }

  class Contrato {
    número: texto
    --
    + descontarSaldo(ítem, cantidad): vacío
  }

}

Item "1" *-- "1" SaldoItem : saldo
Medicion "0..*" --> "1" Item : mide
Medicion "0..*" --> "1" Obra : de la obra
Medicion "0..*" --> "0..1" Contrato : a nombre de
Medicion "1" --> "1..*" ArchivoAdjunto : evidencia
Medicion "0..*" --> "0..*" ElementoModelo : apunta a
VinculoEstructura "0..*" --> "1" Item : de
VinculoEstructura "0..*" --> "1" ElementoModelo : a
Medicion <|-- MedicionAjuste
MedicionAjuste "0..*" --> "1" Medicion : corrige
Obra "1" *-- "1" Certificado : certificado
Certificado "1" *-- "0..*" VersionCertificado : versiones
VersionCertificado "1" *-- "1..*" LineaCertificado : líneas
LineaCertificado "0..1" --> "0..*" Medicion : certifica
LineaCertificado "0..*" --> "1" SaldoItem : ítem

Medicion ..> EstadoMedicion : estado
VersionCertificado ..> EstadoVersionCertificado : estado

@enduml
