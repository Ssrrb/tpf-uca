@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-09 · Estados del Contrato de subcontrato
[*] --> borrador : registrarSubcontrato()\n[usuario admin y proveedor en catálogo]
borrador --> borrador : agregarItem(item, precio, limite)\n[validarLimite() = verdadero]
borrador --> vigente : confirmar(usuarioId)\n/ ItemPresupuesto.asignarCantidad()
borrador --> [*] : cancelar\n/ no se guarda el contrato
vigente --> vigente : habilitarAcceso()\n/ crear UsuarioPortal o agregarContrato()
note right of vigente
  El subcontratista consulta su contrato;
  no registra mediciones (CU-04).
end note
@enduml
