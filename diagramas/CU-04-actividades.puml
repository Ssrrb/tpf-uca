@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-04 · Actividades · Gestionar la medición de avance e insumos
|Ingeniero de obra|
start
:Seleccionar la obra;
|ECMS|
if (¿La obra está en ejecución?) then ([no])
  :Informar que no se registran mediciones;
  stop
else ([sí])
endif
:Mostrar rubros e ítems con cantidad contractual,
medida y saldo contractual (RN-04);
|Ingeniero de obra|
repeat
  :Seleccionar el ítem e ingresar cantidad y unidad;
  :Indicar el ejecutor (propio o el contrato del subcontratista);
  :Cargar los insumos consumidos según el ACU;
  :Adjuntar la evidencia (fotos, planillas o actas);
  |ECMS|
  :Comparar con el saldo contractual y verificar
  que la cantidad no esté contada (RF-09, RF-10);
repeat while (¿Ya está contada en otra medición?) is ([sí]) not ([no])
if (¿Supera el saldo contractual?) then ([sí])
  :Señalar el exceso como saldo negativo del rubro;
  note right
    Queda fuera del certificado hasta
    que se registre una adenda (CU-11).
  end note
else ([no])
endif
|Ingeniero de obra|
repeat
  :Confirmar el registro;
  |ECMS|
repeat while (¿Faltan datos obligatorios o evidencia?) is ([sí]) not ([no])
:Guardar la medición con actor, fecha,
obra, insumos y evidencia (RF-07);
if (¿Es subcontratada?) then ([sí])
  :Descontar la cantidad del saldo del contrato;
else ([no])
endif
|Ingeniero de obra|
stop
@enduml
