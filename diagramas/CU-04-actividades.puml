@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-04 · Actividades · Medir el avance del certificado
|Ingeniero de obra|
start
:Seleccionar la obra;
|Ctrl+ · ECMS|
if (¿La obra está en ejecución?) then ([no])
  :Informar que no se registran mediciones;
  stop
else ([sí])
endif
:Mostrar los ítems con su saldo contractual;
repeat
  |Ingeniero de obra|
  :Ingresar cantidad, ejecutor y evidencia del ítem;
  |Ctrl+ · ECMS|
  :Proponer los insumos consumidos desde el ACU (RF-07);
  |Ingeniero de obra|
  :Corregir los insumos si hace falta;
  |Ctrl+ · ECMS|
  if (¿La cantidad ya está contada?) then ([sí])
    :Rechazar e indicar dónde figura;
  elseif (¿Supera el saldo contractual?) then ([sí])
    :Retener el exceso como saldo negativo
    hasta una adenda (RF-08);
  else ([no])
    :Registrar la medición;
  endif
repeat while (¿Mide otro ítem?) is ([sí]) not ([no])
|Ingeniero de obra|
:Confirmar y cerrar las cantidades de la versión;
|Ctrl+ · ECMS|
:Guardar la versión con avance anterior,
de la versión y acumulado (RF-09);
note right
  Lista para el cálculo (CU-06).
end note
stop
@enduml
