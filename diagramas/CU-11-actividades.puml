@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-11 · Actividades · Registrar adenda
|Ingeniero de obra|
start
:Seleccionar la obra;
|Ctrl+ · ECMS|
:Mostrar los ítems con saldo negativo (CU-06) y las
líneas pendientes de los presupuestos de adendas
del cliente (CU-15);
|Ingeniero de obra|
if (¿Registra una adenda?) then ([no, queda como exceso no reconocido])
  stop
else ([sí])
endif
if (¿Qué registra?) then ([adenda de obra])
  repeat
    :Elegir una línea del presupuesto de adendas
    y cargar la cantidad aprobada, total o parcial,
    y el costo;
    |Ctrl+ · ECMS|
    if (¿Supera la cantidad pendiente de la línea?) then ([sí])
      :Informarlo y no aceptarla;
    else ([no])
      :Agregar el ítem a la adenda;
    endif
    |Ingeniero de obra|
  repeat while (¿Aprueba otra línea?) is ([sí]) not ([no])
else ([ampliación de plazo])
  :Ingresar la nueva fecha de fin;
endif
:Ingresar el motivo y adjuntar el respaldo;
|Ctrl+ · ECMS|
:Calcular precio de venta, costo, límite,
utilizado y saldo (RF-13);
if (¿Supera el límite de la obra?) then ([sí])
  :Informar e impedir confirmar;
  stop
else ([no])
endif
|Ingeniero de obra|
:Confirmar;
|Ctrl+ · ECMS|
if (¿Es ampliación de plazo?) then ([sí])
  :Actualizar la fecha de fin vigente de la obra;
else ([no])
  :Registrar el costo en el apartado Adendas,
  crear los ítems nuevos y sumar la cantidad
  aprobada al saldo contractual (RF-14);
  note right
    Se regulariza en la versión
    siguiente del certificado (CU-06).
  end note
endif
stop
@enduml
