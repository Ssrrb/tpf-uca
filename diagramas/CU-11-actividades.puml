@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-11 · Actividades · Registrar adenda
|Ingeniero de obra|
start
:Seleccionar la obra;
|Ctrl+ · ECMS|
:Mostrar los ítems con saldo negativo
y la cantidad retenida de cada uno;
|Ingeniero de obra|
if (¿Registra una adenda?) then ([no, queda como mayor costo])
  stop
else ([sí])
endif
if (¿Qué registra?) then ([exceso de cantidad de un ítem])
  :Elegir el ítem con exceso y cargar la cantidad,
  el precio de venta y el costo;
elseif (¿Es un trabajo que no existe?) then ([ítem nuevo])
  :Ingresar rubro, descripción, unidad,
  cantidad, precio de venta y costo;
else ([ampliación de plazo])
  :Ingresar la nueva fecha de fin;
endif
:Ingresar el motivo y adjuntar el respaldo;
|Ctrl+ · ECMS|
:Calcular precio de venta, costo, límite,
utilizado y saldo (RF-13);
if (¿Supera el límite de la obra?) then ([sí])
  :Informar e impedir confirmar;
  stop
else ([no])
endif
|Ingeniero de obra|
:Confirmar;
|Ctrl+ · ECMS|
:Registrar el costo en el apartado Adendas
y el precio en el presupuesto de adendas;
if (¿Es ampliación de plazo?) then ([sí])
  :Actualizar la fecha de fin vigente de la obra;
else ([no])
  :Sumar la cantidad al saldo contractual
  y liberar la cantidad retenida (RF-08);
endif
stop
@enduml
