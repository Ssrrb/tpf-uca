@startuml
!theme plain
skinparam style strictuml
title CU-05 · Armar y versionar el presupuesto de costos
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Presupuesto de costos" as PresupuestoCostos {
    --
    + consultarVersiones(): lista de VersionCostos
    + obtenerVigente(): VersionCostos [0..1]
    + guardarPrimeraVersión(base: PresupuestoCliente, actor): VersionCostos
    + guardarVersión(cambios, motivo, actor): VersionCostos
  }

  enum EstadoVersionCostos <<enumeration>> {
    vigente
    historica
  }

  class "Versión del presupuesto de costos" as VersionCostos {
    número: entero
    estado: EstadoVersionCostos
    motivo: texto [0..1]
    creadaPor: Usuario
    fecha: fecha y hora
    --
    + copiarRubros(base: PresupuestoCliente): vacío
    + agregarRubroGastosGenerales(): vacío
    + copiarDe(anterior: VersionCostos): vacío
    + difiereDe(cambios): lógico
    + pasarAHistórica(): vacío
  }

  class Rubro {
    código: texto {estable}
    descripción: texto
    esGastosGenerales: lógico
  }

  class "Ítem" as Item {
    código: texto {estable}
    unidad: texto
    cantidad: decimal
    --
    + cambiarCantidad(cantidad: decimal): vacío
    + moverA(rubro: Rubro): vacío
  }

  class "Presupuesto del cliente" as PresupuestoCliente {
    estado: EstadoPresupuestoCliente
    --
    + obtenerRubros(): lista de Rubro
  }
}

PresupuestoCostos "1" *-- "1..*" VersionCostos : versiones
VersionCostos "0..*" --> "1" PresupuestoCliente : se basa en
VersionCostos "0..1" --> "0..1" VersionCostos : versión anterior
VersionCostos "1" *-- "1..*" Rubro : contiene
Rubro "1" *-- "0..*" Item : agrupa

VersionCostos ..> EstadoVersionCostos : estado

note bottom of Item
  El código se conserva entre versiones y lo vincula con su ítem
  del presupuesto del cliente (RF-05). Los vínculos con el modelo
  y los documentos (CU-14) siguen al ítem por su código.
end note

note bottom of VersionCostos
  La versión que se guarda nace vigente y la anterior pasa a histórica.
  El ejecutor, los insumos, el ACU y el costo de cada ítem
  quedan fuera del MVP.
end note

@enduml
