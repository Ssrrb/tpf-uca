@startuml
!theme plain
skinparam style strictuml
title CU-05 · Mantener catálogos y banco de insumos
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ERP" {
  class "Catálogo" as Catalogo {
    tipo: texto {material | equipo | mano de obra | persona | proveedor | cliente}
    --
    + listar(filtro): lista de Recurso
    + códigoDisponible(código): lógico
    + crearRecurso(datos): Recurso
  }

  abstract class Recurso {
    código: texto
    descripción: texto
    activo: lógico
    --
    + modificar(datos): vacío
    + darDeBaja(actor): vacío
  }

  abstract class Insumo {
    unidad: texto
    categoría: texto
    --
    + registrarPrecio(valor, vigenteDesde): Precio
    + obtenerPrecioVigente(fecha): guaraníes [0..1]
  }

  class Material
  class Equipo
  class "Mano de obra" as ManoDeObra

  class "Persona (RRHH)" as Persona {
    documento: texto
    categoría: texto
  }

  class Proveedor {
    ruc: texto
    esSubcontratista: lógico
  }

  class Cliente {
    ruc: texto
  }

  class Precio {
    valor: guaraníes
    vigenteDesde: fecha
    vigenteHasta: fecha [0..1]
    --
    + seSuperpone(desde: fecha): lógico
    + cerrarVigencia(hasta: fecha): vacío
  }
}

Recurso <|-- Insumo
Insumo <|-- Material
Insumo <|-- Equipo
Insumo <|-- ManoDeObra
Recurso <|-- Persona
Recurso <|-- Proveedor
Recurso <|-- Cliente
Catalogo "1" o-- "0..*" Recurso : contiene
Insumo "1" *-- "0..*" Precio : vigencias
ManoDeObra "0..*" --> "0..*" Persona : la prestan

note bottom of Precio
  Un precio nuevo cierra la vigencia anterior sin borrarla:
  los cálculos ya hechos no cambian (RF-19).
end note

@enduml
