@startuml
!theme plain
skinparam style strictuml
title CU-05 · Mantener catálogos y banco de insumos
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ERP" {
  class "Catálogo" as Catalogo {
    --
    + listar(filtro): lista de Recurso
    + códigoDisponible(código): lógico
    + crearRecurso(datos): Recurso
  }

  class Recurso {
    tipo: texto {persona | proveedor | cliente}
    código: texto
    descripción: texto
    activo: lógico
    ruc: texto [0..1]
    documento: texto [0..1]
    esSubcontratista: lógico [0..1]
    --
    + modificar(datos): vacío
    + darDeBaja(actor): vacío
  }

  class Insumo {
    clase: texto {material | equipo | mano de obra}
    unidad: texto
    categoría: texto
    --
    + registrarPrecio(valor, vigenteDesde): Precio
    + obtenerPrecioVigente(fecha): guaraníes [0..1]
  }

  class Precio {
    valor: guaraníes
    vigenteDesde: fecha
    vigenteHasta: fecha [0..1]
    --
    + seSuperpone(desde: fecha): lógico
    + cerrarVigencia(hasta: fecha): vacío
  }
}

Recurso <|-- Insumo
Catalogo "1" o-- "0..*" Recurso : contiene
Insumo "1" *-- "0..*" Precio : vigencias
Insumo "0..*" --> "0..*" Recurso : mano de obra que prestan las personas
@enduml
