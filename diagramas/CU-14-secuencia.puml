@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-14 · Registrar cobros y pagos
actor "Finanzas y tesorería" as Fin
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
end box
box "Motor de finanzas" #EAF2F6
participant "documento:\nDocumentoPendiente" as Doc
participant "movimiento:\nMovimiento" as Mov
participant "retencion:\nRetencionMovimiento" as Ret
participant "comprobante:\nComprobante" as Comp
end box

Fin -> Obra: permiteCobrosYPagos()
Obra --> Fin: permitido hasta la recepción definitiva (RF-23)
alt factura a cobrar o liquidación a pagar (paso 1)
  Fin -> Doc: mostrarConOrigen()
else devolución del fondo de reparo (1a)
  Fin -> Obra: estaEnRecepciónDefinitiva()
  Obra --> Fin: sí
  Fin -> Doc: mostrarConOrigen()
end
Doc --> Fin: documento, versión del certificado de la que deriva y saldo

create Mov
Fin -> Mov: «create» Cobro o Pago(importe, fecha, medio)
opt el cliente es agente de retención
  Fin -> Mov: agregarRetención(tipo, importe, comprobante)
  create Ret
  Mov -> Ret: «create»(tipo, importe)
end
Fin -> Mov: adjuntarComprobante(archivo)
create Comp
Mov -> Comp: «create»(tipo, archivo)
Mov -> Doc: validarImporte(importe, retenciones)
Doc --> Mov: válido: lógico
break importe + retenciones supera el saldo pendiente (5a, RF-20)
  Mov --> Fin: lo informa e impide registrar (vuelve al paso 3)
end
Fin -> Mov: confirmar(actor)
break falta el comprobante (6a)
  Mov --> Fin: marca el campo e impide confirmar (vuelve al paso 4)
end
Mov -> Doc: actualizarSaldo(movimiento)
Doc --> Fin: saldo actualizado; lo refleja el tablero (CU-13)
note over Fin, Comp
  3a: si el cobro o pago es parcial, el documento queda
  con saldo pendiente y se puede volver a registrar.
end note
@enduml
