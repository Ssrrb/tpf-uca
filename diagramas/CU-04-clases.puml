@startuml
!theme plain
skinparam style strictuml
title CU-04 · Medir el avance del certificado
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Ítem de costos" as ItemCostos {
    código: texto {estable}
    unidad: texto
    --
    + obtenerSaldo(): SaldoÍtem
    + insumosDelACU(cantidad): lista de ConsumoInsumo
  }

  class "Saldo del ítem" as SaldoItem {
    cantidadCliente: decimal
    cantidadAdendas: decimal
    asignadaAContratos: decimal
    medida: decimal
    certificada: decimal
    liquidada: decimal
    retenida: decimal
    /saldoContractual: decimal
    --
    + saldoContractual(): decimal
    + estaContada(cantidad, medición): lógico
    + registrarMedición(cantidad): vacío
    + retenerExceso(cantidad): vacío
    + revertirMedición(cantidad): vacío
    + cantidadCertificable(): decimal
  }

  class "Medición" as Medicion {
    cantidad: decimal
    unidad: texto
    ejecutor: propio | subcontratado
    estado: EstadoMedición
    motivo: texto [0..1]
    registradaPor: Usuario
    fecha: fecha y hora
    --
    + corregirInsumo(insumo, cantidad): vacío
    + adjuntarEvidencia(archivo): vacío
    + validarCompleta(): lista de texto
    + confirmar(actor): vacío
    + anular(motivo, actor): vacío
    + puedeAnularse(): lógico
    + registrarAjuste(cantidad, motivo, actor): MediciónAjuste
    + incluirEn(versión): vacío
  }

  class "Medición de ajuste" as MedicionAjuste {
    signo: positivo | negativo
  }

  class "Consumo de insumo" as ConsumoInsumo {
    cantidad: decimal
    origen: ACU | corregido
  }

  class Evidencia {
    tipo: foto | planilla | acta
    archivo: archivo
  }

  class "Certificado de avance" as Certificado {
    --
    + generarVersiónSiguiente(actor): VersiónCertificado
  }

  class "Versión del certificado" as VersionCertificado {
    número: entero
    estado: cantidades cerradas | valorizada
    --
    + tomarCantidades(): vacío
    + cerrarCantidades(actor): vacío
  }

  class "Línea del certificado" as LineaCertificado {
    tipo: cantidad | ajuste
    avanceAnterior: decimal
    cantidad: decimal
    /acumulado: decimal
  }

  enum EstadoMedición {
    registrada
    retenida
    incluida
    certificada
    anulada
  }
}

package "ERP" {
  class Obra {
    estado: EstadoObra
    --
    + permiteMediciones(): lógico
  }

  class Contrato {
    número: texto
    --
    + descontarSaldo(ítem, cantidad): vacío
  }

  class Insumo {
    código: texto
    unidad: Unidad
  }
}

ItemCostos "1" *-- "1" SaldoItem : lleva
Medicion "0..*" --> "1" ItemCostos : mide
Medicion "0..*" --> "1" Obra : de la obra
Medicion "0..*" --> "0..1" Contrato : a nombre de
Medicion "1" *-- "0..*" ConsumoInsumo : insumos consumidos
Medicion "1" *-- "1..*" Evidencia : respaldo
ConsumoInsumo "0..*" --> "1" Insumo : de
Medicion <|-- MedicionAjuste
MedicionAjuste "0..*" --> "1" Medicion : corrige
Certificado "0..1" --> "1" Obra : de la obra
Certificado "1" *-- "0..*" VersionCertificado : versiones numeradas
VersionCertificado "1" *-- "1..*" LineaCertificado : líneas
LineaCertificado "0..1" --> "0..*" Medicion : incluye
LineaCertificado "0..*" --> "1" SaldoItem : ítem

note bottom of SaldoItem
  saldoContractual = cliente + adendas - certificada.
  Lo que lo supera queda retenido hasta una adenda,
  y una cantidad se cuenta una sola vez (RF-10).
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
