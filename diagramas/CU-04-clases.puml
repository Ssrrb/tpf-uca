@startuml
!theme plain
skinparam style strictuml
title CU-04 · Validar y finalizar el presupuesto del cliente
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ERP" {
  class Obra {
    código: texto
    --
    + vincularPresupuestoCliente(presupuesto): vacío
  }
}

package "ECMS" {

  class "Presupuesto del cliente" as PresupuestoCliente {
    estado: EstadoPresupuestoCliente
    totalDeclarado: guaraníes [0..1]
    totalRecalculado: guaraníes
    /diferenciaTotal: guaraníes [0..1]
    finalizadoPor: Usuario [0..1]
    fechaFinalización: fecha y hora [0..1]
    --
    + validarDatos(): InformeImportacion
    + recalcularTotales(): guaraníes
    + compararTotales(): InformeImportacion
    + finalizar(actor): vacío
  }

  class Hoja {
    nombre: texto
    --
    + validarFilas(informe): vacío
  }

  class Columna {
    campoDestino: texto
    obligatoria: lógico
    --
    + validarValor(valor: texto): lógico
  }

  class Rubro {
    código: texto
    totalDeclarado: guaraníes [0..1]
    --
    + recalcularTotal(): guaraníes
  }

  class "Ítem del cliente" as ItemCliente {
    código: texto
    cantidad: decimal
    precioUnitario: guaraníes
    /total: guaraníes
    --
    + recalcularTotal(): guaraníes
  }

  class "Informe de importación" as InformeImportacion {
    fecha: fecha y hora
    diferenciasAceptadas: lógico
    --
    + registrarError(hoja, fila, columna, motivo): vacío
    + registrarDiferencia(rubro, declarado, recalculado): vacío
    + aceptarDiferencias(): vacío
  }

  enum EstadoPresupuestoCliente <<enumeration>> {
    en_carga
    propuesta
    finalizado
  }
}

Obra "1" *-- "0..1" PresupuestoCliente : presupuesto contractual
PresupuestoCliente "1" *-- "0..*" Hoja : estructura
Hoja "1" *-- "1..*" Columna : define
PresupuestoCliente "1" *-- "1..*" Rubro : contiene
Rubro "1" *-- "1..*" ItemCliente : ítems cliente
PresupuestoCliente "1" *-- "0..*" InformeImportacion : informes

PresupuestoCliente ..> EstadoPresupuestoCliente : estado
note bottom of PresupuestoCliente
  Finalizado no se modifica (RF-04): es la base de la estructura
  de trabajo, cuya versión 1 guarda CU-05; los cambios van
  por las versiones de esa estructura (CU-05).
end note

@enduml
