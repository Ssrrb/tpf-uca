@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title Diagrama de Subsistemas de Ctrl+
skinparam nodesep 40
skinparam ranksep 60
skinparam linetype ortho
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}

package "Tablero y actividad\n(CU-16)" as tab #FFF4D6 {
}
package "Registro de liquidaciones\n(CU-09)" as reg #E3F1E3 {
}
package "Incidencias\n(CU-15)" as inc #FFF4D6 {
}
package "Liquidación de subcontratistas\n(CU-09)" as liq #FFF4D6 {
}
package "Cálculo del certificado\n(CU-08)" as cal #E3F1E3 {
}
package "Mediciones\n(CU-07)" as med #FFF4D6 {
}
package "Vínculos\n(CU-14)" as vin #FFF4D6 {
}
package "Modelos\n(CU-12, CU-13)" as mod #FFF4D6 {
}
package "Presupuestos\n(CU-03, CU-04, CU-05)" as pre #FFF4D6 {
}
package "Contratos\n(CU-06)" as con #EAF2F6 {
}
package "Documentación de obra\n(CU-10, CU-11)" as doc #EAF2F6 {
}
package "Obras y usuarios\n(CU-01)" as obr #EAF2F6 {
}
package "Catálogos\n(CU-02)" as cat #EAF2F6 {
}

legend right
  | <back:#EAF2F6>   </back> ERP |
  | <back:#FFF4D6>   </back> ECMS |
  | <back:#E3F1E3>   </back> Motor de finanzas |
endlegend

tab .down.> inc
tab .down.> cal
reg .down.> liq
liq .down.> cal
liq .down.> con
cal .down.> med
med .down.> vin
med .down.> con
inc .down.> mod
vin .down.> mod
mod .down.> pre
mod .down.> doc
pre .down.> obr
doc .down.> obr
con .down.> obr
obr .down.> cat

@enduml
