@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title Diagrama de Subsistemas de Ctrl+
skinparam nodesep 50
skinparam ranksep 70
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}


show circle
skinparam classBackgroundColor #FFF9DB
skinparam classBorderColor #17324D

package "Motor de finanzas" {
  class "Cálculo del certificado" as CalculoCertificado
  class "Certificado" as Certificado
  class "Registro de liquidaciones" as RegistroLiquidacion
  class "Retención" as Retencion
}

package "ECMS" {
  class "Medición" as Medicion
  class "Liquidación" as Liquidacion
  class "Presupuesto de costos" as PresupuestoCostos
  class "Incidencia" as Incidencia
  class "BIM" as Modelo
}

package "ERP" {
  class "Presupuesto del cliente" as Contrato
  class "Usuario" as Usuario
  class "Documento" as Documento
}

CalculoCertificado -- Certificado
CalculoCertificado -- Retencion
Certificado -- RegistroLiquidacion
Medicion -- Liquidacion
Medicion -- PresupuestoCostos
Incidencia -- Modelo

CalculoCertificado -- Medicion
RegistroLiquidacion -- Liquidacion
PresupuestoCostos -- Contrato
Usuario -- Documento
Modelo -- Documento

@enduml
