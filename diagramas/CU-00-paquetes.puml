@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title Diagrama de Subsistemas de Ctrl+
skinparam nodesep 50
skinparam ranksep 70
skinparam linetype ortho
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}


package "Motor de finanzas" {
  class "Cálculo del certificado" as CalculoCertificado
  class "Registro de liquidaciones" as RegistroLiquidacion
}

package "ECMS" {
  class "Medición" as Medicion
  class "Liquidación" as Liquidacion
  class "Presupuesto de costos" as PresupuestoCostos
  class "Incidencia" as Incidencia
  class "Modelo" as Modelo
}

package "ERP" {
  class "Contrato" as Contrato
  class "Obra" as Obra
  class "Usuario" as Usuario
  class "Documento" as Documento
}

CalculoCertificado -down- Medicion
RegistroLiquidacion -down- Liquidacion
Liquidacion -down- Contrato
PresupuestoCostos -down- Obra
Incidencia -down- Usuario
Modelo -down- Documento

@enduml
