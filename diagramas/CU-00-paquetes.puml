@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title Diagrama de Subsistemas de Ctrl+
skinparam nodesep 30
skinparam ranksep 50
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}

package "ERP" as erp #EAF2F6 {
  package "Obras y usuarios\n(CU-01)" as obr #FFFFFF {
  }
  package "Catálogos\n(CU-02)" as cat #FFFFFF {
  }
  package "Contratos\n(CU-06)" as con #FFFFFF {
  }
  package "Documentación de obra\n(CU-10, CU-11)" as doc #FFFFFF {
  }
}

package "ECMS" as ecms #EAF2F6 {
  package "Presupuestos\n(CU-03, CU-04, CU-05)" as pre #FFFFFF {
  }
  package "Modelos\n(CU-12, CU-13)" as mod #FFFFFF {
  }
  package "Vínculos\n(CU-14)" as vin #FFFFFF {
  }
  package "Incidencias\n(CU-15)" as inc #FFFFFF {
  }
  package "Mediciones\n(CU-07)" as med #FFFFFF {
  }
  package "Liquidación de subcontratistas\n(CU-09)" as liq #FFFFFF {
  }
  package "Tablero y actividad\n(CU-16)" as tab #FFFFFF {
  }
}

package "Motor de finanzas" as mf #EAF2F6 {
  package "Cálculo del certificado\n(CU-08)" as cal #FFFFFF {
  }
  package "Registro de liquidaciones\n(CU-09)" as reg #FFFFFF {
  }
}

tab ..> cal
tab ..> inc
reg ..> liq
liq ..> cal
liq ..> con
cal ..> med
med ..> vin
med ..> con
inc ..> mod
vin ..> mod
mod ..> pre
mod ..> doc
pre ..> obr
doc ..> obr
con ..> obr
obr ..> cat

@enduml
