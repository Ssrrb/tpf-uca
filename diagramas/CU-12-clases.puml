@startuml
!theme plain
skinparam style strictuml
title CU-12 · Liquidar subcontratista
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Versión del certificado" as VersionCertificado {
    número: entero
    estado: cantidades cerradas | valorizada
    --
    + líneasSubcontratadasPorContrato(): lista
    + enviarALiquidar(contrato, actor): texto
  }

  class "Línea del certificado" as LineaCertificado {
    cantidad: decimal
    liquidada: lógico
    --
    + estaLiquidada(): lógico
    + marcarLiquidada(liquidación): vacío
  }
}

package "Motor de finanzas" {
  class "Liquidaciones" as Liquidaciones {
    --
    + liquidar(versión, contrato, cantidades): Liquidación
    + buscar(versión, contrato): Liquidación [0..1]
  }

  class "Liquidación" as Liquidacion {
    número: entero
    bruto: guaraníes
    retenciones: guaraníes
    fondoReparo: guaraníes
    deducciones: guaraníes
    impuestos: guaraníes
    /neto: guaraníes
    estado: pendiente_de_pago | pagada_parcial | pagada
    --
    + calcular(contrato): vacío
  }
}

package "ERP" {
  class Contrato {
    número: texto
    porcentajeFondoReparo: decimal
    impuestos: decimal
    --
    + valorizar(ítem, cantidad): guaraníes
    + excedeLímite(importe): lógico
  }

  class "Retención" as Retencion {
    tipo: IVA | renta
    porcentaje: decimal
    --
    + aplicar(base: guaraníes): guaraníes
  }
}

VersionCertificado "1" *-- "1..*" LineaCertificado : líneas
LineaCertificado "0..*" --> "0..1" Contrato : subcontratada en
LineaCertificado "0..*" --> "0..1" Liquidacion : liquidada en
Liquidaciones ..> Liquidacion : registra
Liquidacion "0..*" --> "1" Contrato : de
Liquidacion "0..1" --> "1" VersionCertificado : por
Contrato "0..*" --> "0..*" Retencion : aplica

@enduml
