@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-11 · Registrar adenda
actor "Ingeniero de obra" as Ing
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
end box
box "ECMS" #EAF2F6
participant "costos:\nPresupuestoCostos" as PC
participant "apartado:\nApartadoAdendas" as Apa
participant "adenda:\nAdenda" as Ad
participant "item:\nItemCostos" as Item
participant "saldo:\nSaldoItem" as Saldo
participant "adendas:\nPresupuestoAdendas" as PA
end box

Ing -> Obra: permiteAdendas()
Obra --> Ing: permitido hasta la recepción definitiva (RF-33)
Ing -> PC: ítemsConSaldoNegativo()
loop por cada ítem con exceso
  PC -> Saldo: cantidadRetenida()
  Saldo --> PC: cantidad medida retenida
end
PC --> Ing: ítems con saldo negativo y cantidad retenida (RF-09)

alt exceso o cambio de un ítem (paso 3; 2a sin exceso medido)
  Ing -> Apa: crearAdenda(ítem, tipo, cantidad, precioVenta, costo)
  create Ad
  Apa -> Ad: «create»(ítem, tipo, cantidad, precioVenta, costo)
else ítem nuevo (2b)
  Ing -> Apa: crearÍtemNuevo(rubro, descripción, unidad)
  create Item
  Apa -> Item: «create»(rubro, descripción, unidad)
  Apa -> Ad: «create»(ítem nuevo, cantidad, precioVenta, costo)
  note right of Item
    Desde ahora admite mediciones (CU-04)
    que entran en el certificado (CU-06).
  end note
else ampliación de plazo (2c)
  Ing -> Apa: crearAdenda(obra, ampliación de plazo, nuevaFechaFin)
  Apa -> Ad: «create»(ampliación de plazo, nuevaFechaFin)
else decide no registrar adenda (3a)
  note over Ing, PA
    El rubro queda en negativo como mayor costo
    y la cantidad sigue fuera del certificado.
  end note
end

Ing -> Ad: adjuntarRespaldo(motivo, archivo)
Ad -> Ad: calcularImportes()
Apa -> Obra: obtenerLímiteAdendas()
Obra --> Apa: límite
Apa -> Apa: utilizado()
Apa --> Ing: precio de venta, costo, límite, utilizado y saldo (RF-20)
break la adenda supera el límite de la obra (5a)
  Apa --> Ing: lo informa e impide confirmar
end

Ing -> Apa: registrar(adenda, actor)
Apa -> Ad: validarDatos()
Ad --> Apa: faltantes
break faltan motivo, respaldo o importes (6a)
  Apa --> Ing: marca los campos (vuelve al paso 3)
end
critical registro atómico (NF-03)
  Apa -> PA: registrarPrecio(adenda)
  alt ampliación de plazo
    Apa -> Obra: actualizarFechaFin(fecha, motivo)
  else ampliación, deducción, variación o ítem nuevo
    Apa -> Saldo: sumarAdenda(cantidad)
    Apa -> Saldo: liberarRetenida(cantidad)
  end
end
Apa --> Ing: costo en el apartado Adendas y precio en el presupuesto\nde adendas, con actor y fecha (RF-21, RN-04)
@enduml
