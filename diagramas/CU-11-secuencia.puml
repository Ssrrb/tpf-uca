@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-11 · Registrar adenda
actor "Ingeniero de obra" as Ing
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
end box
box "ECMS" #EAF2F6
participant "costos:\nPresupuestoCostos" as PC
participant "presupuestoAdendas:\nPresupuestoAdendas" as PA
participant "apartado:\nApartadoAdendas" as Apa
participant "adenda:\nAdenda" as Ad
participant "linea:\nLineaPresupuestoAdendas" as Lin
participant "itemAdenda:\nItemAdenda" as IA
participant "item:\nItemCostos" as Item
participant "saldo:\nSaldoItem" as Saldo
end box

Ing -> Obra: permiteAdendas()
Obra --> Ing: permitido hasta la recepción definitiva (RF-23)
Ing -> PC: ítemsEnExceso()
PC --> Ing: ítems con saldo negativo e importe en exceso (CU-06)
Ing -> PA: líneasPendientes()
PA --> Ing: líneas del presupuesto de adendas del cliente\ncon cantidad pendiente y precio de venta (CU-15)
break no registra adenda (2b)
  note over Ing, Saldo
    El exceso queda no reconocido como mayor costo
    y sigue señalado en el certificado (RF-08).
  end note
end

Ing -> Apa: crearAdenda(tipo, motivo, respaldo)
create Ad
Apa -> Ad: «create»(número siguiente, tipo, motivo, respaldo)
alt adenda de obra (paso 3)
  loop por cada línea que aprueba
    Ing -> Ad: agregarÍtem(línea, cantidadAprobada, costo)
    Ad -> Lin: cantidadPendiente()
    Lin --> Ad: pendiente
    break la cantidad aprobada supera la pendiente (3c)
      Ad --> Ing: lo informa y no la acepta
    end
    create IA
    Ad -> IA: «create»(línea, cantidadAprobada, precioVenta, costo)
    note right of IA
      Puede aprobar solo una parte (3a).
    end note
  end
else ampliación de plazo (2a)
  Ing -> Ad: fijarNuevaFechaFin(fecha)
end

Ad -> Ad: calcularImportes()
Apa -> Obra: obtenerLímiteAdendas()
Obra --> Apa: límite
Apa -> Apa: utilizado()
Apa --> Ing: precio de venta, costo, límite, utilizado y saldo (RF-13)
break la adenda supera el límite de la obra (4a)
  Apa --> Ing: lo informa e impide confirmar
end

Ing -> Apa: registrar(adenda, actor)
Apa -> Ad: validarDatos()
Ad --> Apa: faltantes
break faltan motivo, respaldo o importes (5a)
  Apa --> Ing: marca los campos (vuelve al paso 3)
end
critical registro atómico (NF-02)
  alt ampliación de plazo
    Apa -> Obra: actualizarFechaFin(fecha, motivo)
  else adenda de obra
    loop por cada ítem de la adenda
      opt la línea es un ítem nuevo (3b)
        create Item
        Apa -> Item: «create»(rubro, descripción, unidad)
      end
      Apa -> Saldo: sumarAdenda(cantidadAprobada)
      Apa -> Lin: descontarAprobada(cantidadAprobada)
    end
  end
end
Apa --> Ing: costo en el apartado Adendas del presupuesto de costos;\nlo aprobado se regulariza en la versión siguiente\ndel certificado (CU-06, RF-14, RF-08)
@enduml
