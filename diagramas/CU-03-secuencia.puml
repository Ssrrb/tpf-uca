@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-03 · Cargar el presupuesto del cliente
actor "Ingeniero de obra" as Ing
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
end box
box "ECMS" #EAF2F6
participant "presupuesto:\nPresupuestoCliente" as Pres
participant "archivo:\nArchivoOriginal" as Arch
participant "hoja:\nHoja" as Hoja
participant "rubro:\nRubro" as Rubro
participant "item:\nItemCliente" as Item
end box

Ing -> Obra: crearPresupuestoCliente(actor)
break la obra ya tiene un presupuesto del cliente finalizado
  Obra --> Ing: operación rechazada (RF-04)
end
create Pres
Obra -> Pres: «create»()
Obra --> Ing: presupuesto registrado

alt carga desde XLSX
  Ing -> Pres: cargarArchivo(archivo)
  Pres -> Arch: validarFormato()
  Arch --> Pres: válido: lógico
  break no es XLSX, está dañado o tiene contraseña (2a)
    Pres --> Ing: carga rechazada con el motivo
  end
  Pres -> Pres: esArchivoRepetido(huella)
  break el mismo XLSX ya se cargó sin cambios (2b, NF-06)
    Pres --> Ing: lo informa; no se crea otra carga
  end
  Pres -> Arch: guardar()
  break falla el guardado (NF-02)
    Pres -> Pres: descartarCargaIncompleta()
    Pres --> Ing: carga descartada; se puede reintentar
  end
  note right of Pres: estado En carga
  Pres -> Pres: identificarEstructura()
  loop por cada hoja que no es del cliente (3b)
    Pres -> Hoja: ignorar()
    Pres --> Ing: la ignora y lo informa
  end
  alt estructura identificada
    Pres --> Ing: hojas, columnas, rubros e ítems (RF-03)
  else no se identifica la estructura (3a)
    loop por cada columna que falta definir
      Ing -> Hoja: definirColumna(índice, campo)
    end
  end
else creación en el sistema sin XLSX (1a)
  note right of Pres: estado Propuesta
  loop por cada rubro
    Ing -> Pres: agregarRubro(código, descripción)
    create Rubro
    Pres -> Rubro: «create»(código, descripción)
    loop por cada ítem del rubro
      Ing -> Rubro: agregarÍtem(código, descripción, unidad, cantidad, precio)
      create Item
      Rubro -> Item: «create»(código, descripción, unidad, cantidad, precio)
    end
  end
end
Ing -> Pres: confirmarEstructura()
Pres --> Ing: carga guardada en estado Propuesta, lista para validar
ref over Ing, Rubro
  Validar y finalizar el presupuesto del cliente (CU-04).
end ref
@enduml
