@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-03 · Armar y versionar el presupuesto de costos
actor "Ingeniero de obra" as Ing
box "ECMS" #EAF2F6
participant "costos:\nPresupuestoCostos" as PC
participant "cliente:\nPresupuestoCliente" as Cli
participant "version:\nVersionCostos" as V
participant "anterior:\nVersionCostos" as Ant
participant "gg:\nRubroCostos" as GG
participant "item:\nItemCostos" as Item
participant "acu:\nACU" as Acu
participant "linea:\nLineaACU" as Lin
participant "apartado:\nApartadoAdendas" as Apa
end box
box "ERP" #EAF2F6
participant "insumo:\nInsumo" as Ins
end box

Ing -> PC: consultarVersiones()
PC -> Apa: costoTotal()
PC --> Ing: presupuesto del cliente, versiones con su estado,\napartado Adendas y presupuesto de adendas (RF-06)

alt primera versión (paso 3)
  Ing -> PC: crearPrimeraVersión(cliente, actor)
  create V
  PC -> V: «create»(estado = propuesta)
  PC -> V: copiarRubros(cliente)
  V -> Cli: obtenerRubros()
  Cli --> V: rubros e ítems con su código
  PC -> V: agregarRubroGastosGenerales()
  create GG
  V -> GG: «create»("Gastos generales de obra")
else completar ítems no certificados de la vigente (3a)
  Ing -> PC: obtenerVigente()
  PC --> Ing: version vigente
else corregir un error o reflejar un retrabajo (3b)
  Ing -> PC: crearVersiónCorrectiva(motivo, actor)
  PC -> PC: obtenerVigente()
  create V
  PC -> V: «create»(estado = propuesta, anterior, motivo)
  note right of V
    Los rubros e ítems conservan su código
    y lo ya registrado sigue vinculado (RN-02).
  end note
end

loop por cada ítem a completar
  Ing -> V: completarÍtem(ítem, ejecutor, acu)
  V -> Item: estaCertificado()
  Item --> V: certificado: lógico
  break ítem certificado de la vigente (5a)
    V --> Ing: lo impide; la corrección va por una versión nueva (3b)
  end
  V -> Item: definirEjecutor(ejecutor)
end

V -> V: calcularCosto()
loop por cada ítem
  V -> Item: calcularCostoPresupuestado()
  Item -> Acu: calcularCostoUnitario(fecha)
  loop por cada línea del ACU
    Acu -> Lin: calcularCosto(fecha)
    Lin -> Ins: obtenerPrecioVigente(fecha)
    Ins --> Lin: precio [0..1]
    opt insumo sin precio vigente (6a)
      Lin --> Ing: señala el insumo; no calcula ese ítem
    end
  end
end
V -> V: validarDatos()
V --> Ing: costo por ítem y rubro, datos faltantes

alt confirma (paso 7)
  Ing -> PC: activar(version, actor)
  critical activación atómica (NF-03)
    alt versión nueva
      PC -> Ant: pasarAHistórica()
      PC -> V: marcarVigente(actor)
    else misma versión vigente (3a)
      PC --> Ing: guarda el detalle sin crear otra versión
    end
  end
  break falla la activación (8a)
    PC --> Ing: revierte; la vigente anterior no cambia
  end
  PC --> Ing: versión vigente con actor, fecha y motivo
else cancela (7a)
  Ing -> V: cancelar()
end
@enduml
