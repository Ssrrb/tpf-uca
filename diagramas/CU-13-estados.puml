@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-13 · Estados de la Línea de certificado subcontratada
[*] --> sin_liquidar : la versión del certificado\nse envía a facturar (CU-07)
sin_liquidar --> en_liquidacion : LiquidacionSubcontrato.agregarLinea(linea)\n[estaLiquidada() = falso]
en_liquidacion --> sin_liquidar : el Administrador no confirma\no el ERP rechaza el envío
en_liquidacion --> liquidada : registrarReferenciaERP(numero, monto)\n/ marcarLiquidada(liquidacion)
liquidada --> liquidada : agregarLinea(linea) en otra versión\n[estaLiquidada() = verdadero] / se excluye
liquidada --> [*]
note right of liquidada
  Una cantidad se liquida una sola vez (RF-10).
  El pago sigue en tesorería (CU-15).
end note
@enduml
