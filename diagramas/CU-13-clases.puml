@startuml
!theme plain
skinparam style strictuml
title CU-13 · Consultar tablero financiero
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "Motor de finanzas" {
  class "Tablero financiero" as Tablero {
    alcance: obra | empresa
    fechaConsulta: fecha
    filtro: rubro [0..1]
    --
    + consultar(alcance, usuario): lista de TotalTablero
    + filtrar(rubro, fecha): vacío
    + abrirRespaldo(total): lista de archivo
    + exportar(formato: XLSX | PDF): archivo
  }

  class "Total del tablero" as TotalTablero {
    concepto: texto
    importe: guaraníes
    fecha: fecha
    unidad: texto
    moneda: texto = PYG
    procedencia: ECMS | Motor de finanzas
    disponible: lógico
  }

  class "Libro financiero" as LibroFinanciero {
    --
    + totales(obra, fecha): lista de TotalTablero
    + resultadoEconómico(obra, fecha): guaraníes
    + resultadoFinanciero(obra, fecha): guaraníes
  }
}

package "ECMS" {
  class "Resumen de obra" as ResumenObra {
    --
    + presupuestado(obra): lista de TotalTablero
    + certificadoPorRubro(obra, fecha): lista
    + avanceFísico(obra, fecha): porcentaje
  }
}

package "ERP" {
  class Usuario {
    --
    + tieneAcceso(obra): lógico
  }

  class Obra {
    fechaInicio: fecha
    fechaFinVigente: fecha
    --
    + plazoTranscurrido(fecha): porcentaje
  }
}

Tablero "1" *-- "0..*" TotalTablero : muestra
Tablero ..> LibroFinanciero : usa
Tablero ..> ResumenObra : usa
Tablero ..> Usuario : verifica acceso (NF-01)
ResumenObra ..> Obra : de
LibroFinanciero ..> Obra : de

note bottom of TotalTablero
  Cada total indica fecha, unidad, moneda
  y procedencia, y abre su respaldo (NF-11, NF-12).
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
