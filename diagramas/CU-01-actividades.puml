@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-01 · Actividades · Gestionar obra
|Administrador|
start
if (¿Crear una obra o avanzar el estado de una existente?) then ([crear])
  :Solicitar crear una obra;
  repeat
    :Ingresar código, nombre, dirección, fechas, cliente,
    impuestos, límite de adendas, tope de caja chica
    y, si corresponde, anticipo y fondo de reparo;
    :Asignar los responsables y el rol de cada uno;
    :Confirmar la creación;
    |ERP|
    if (¿El código ya está en uso?) then ([sí])
      :Pedir otro código;
    elseif (¿Algún responsable no es miembro?) then ([sí])
      :Rechazar la asignación;
    else ([no])
      :Registrar la obra en ejecución, sus
      responsables, el actor y la fecha;
    endif
    |Administrador|
  repeat while (¿Hubo un rechazo?) is ([sí]) not ([no])
else ([avanzar estado])
  :Elegir una obra existente;
  |ERP|
  if (¿La obra está cerrada?) then ([sí])
    :Informar que no hay estado siguiente;
  else ([no])
    :Pasar al estado siguiente y registrar
    actor y fecha (RF-33);
  endif
endif
|Administrador|
stop
@enduml
