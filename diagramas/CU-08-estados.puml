@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-08 · Estados de la Factura interna
state confirmacion <<choice>>
state cobro <<choice>>
state "Generada" as generada
state "Pendiente de adjuntar la legal" as pendiente_de_adjuntar
state "A cobrar" as a_cobrar
state "Cobrada parcialmente" as cobrada_parcial
state "Cobrada" as cobrada

[*] --> generada : generarFactura(versión, actor)
generada --> confirmacion : confirmar(actor)
confirmacion --> pendiente_de_adjuntar : [sin factura legal (3a)]
confirmacion --> a_cobrar : [factura legal adjunta]
pendiente_de_adjuntar --> a_cobrar : adjuntarFacturaLegal(número, fecha, importe, archivo)
a_cobrar --> cobro : registrarCobro(importe, retenciones) [CU-14]
cobrada_parcial --> cobro : registrarCobro(importe, retenciones) [CU-14]
cobro --> cobrada_parcial : [queda saldo pendiente]
cobro --> cobrada : [saldo = 0]
cobrada --> [*]

note right of a_cobrar
  Una nota de crédito interna sigue
  el mismo ciclo con signo negativo.
end note
@enduml
