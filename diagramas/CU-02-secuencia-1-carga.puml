@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-02 · 1/3 · Carga del XLSX o creación en el sistema
actor "Ingeniero de obra" as Ing
box "ECMS" #EAF2F6
participant "obra:\nObra" as Obra
participant "presupuesto:\nPresupuestoCliente" as Pres
participant "archivo:\nArchivoOriginal" as Arch
participant "rubro:\nRubro" as Rubro
end box

Ing -> Obra: crearPresupuestoCliente(actor)
break la obra ya tiene un presupuesto del cliente finalizado
  Obra --> Ing: operación rechazada (RN-01)
end
create Pres
Obra -> Pres: «create»(estado = propuesta)
Obra --> Ing: presupuesto en propuesta

alt carga desde XLSX
  Ing -> Pres: cargarArchivo(archivo)
  Pres -> Arch: validarFormato()
  Arch --> Pres: válido: lógico
  break no es XLSX, está dañado, tiene contraseña o supera el tamaño (2a)
    Pres --> Ing: carga rechazada con el motivo; vuelve al paso 1
  end
  Pres -> Pres: esArchivoRepetido(huella)
  break el mismo XLSX ya se cargó sin cambios (2b, NF-07)
    Pres --> Ing: lo informa; no se crea otra carga
  end
  Pres -> Arch: guardar()
  break falla el guardado o se interrumpe la carga (*a)
    Pres -> Pres: descartarCargaIncompleta()
    Pres --> Ing: carga descartada; se puede reintentar
  end
  Pres --> Ing: archivo original guardado (RF-02)
  ref over Ing, Rubro
    Continúa en 2/3: estructura y validación.
  end ref
else creación en el sistema sin XLSX (1a)
  loop por cada rubro
    Ing -> Pres: agregarRubro(código, descripción)
    create Rubro
    Pres -> Rubro: «create»(código, descripción)
    loop por cada ítem del rubro
      Ing -> Rubro: agregarÍtem(código, descripción, unidad, cantidad, precio)
    end
  end
  ref over Ing, Rubro
    Continúa en 2/3 desde la confirmación de la estructura (paso 4).
  end ref
end
@enduml
