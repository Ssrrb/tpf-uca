@startuml
!theme plain
hide circle
hide empty members
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam nodesep 35
skinparam ranksep 45
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-03 · Activar y versionar el presupuesto

class "Motor de ingeniería" as MotorIngenieria <<control>> {
  --
  + prepararActivacion(obra: Obra, version: VersionPresupuesto): lista de texto
  + activarVersion(obra: Obra, version: VersionPresupuesto): VersionPresupuesto
  + cancelar(): vacío
}

class Obra {
  + identificador: identificador
  + codigo: texto
  + nombre: texto
  --
  + usuarioPuedeActivar(usuarioId: identificador): lógico
  + obtenerPresupuestoCostos(): Presupuesto
}

class Presupuesto {
  + identificador: identificador
  + tipo: cliente | costos | adenda
  + moneda: texto = "PYG"
  --
  + obtenerVigente(): VersionPresupuesto [0..1]
  + activarVersion(version: VersionPresupuesto, usuarioId: identificador): vacío
}

class "Versión de presupuesto" as VersionPresupuesto {
  + identificador: identificador
  + numero: entero
  + estado: disponible | vigente | historica
  + estructuraConfirmada: lógico
  + datosValidos: lógico
  + archivoOriginalId: identificador
  + fechaActivacion: fecha y hora [0..1]
  + usuarioActivacionId: identificador [0..1]
  --
  + verificarActivable(): lista de texto
  + activar(usuarioId: identificador): vacío
  + pasarAHistorica(): vacío
}

MotorIngenieria ..> Obra : consulta
MotorIngenieria ..> Presupuesto : activa
Obra "1" *-- "1..*" Presupuesto : tiene
Presupuesto "1" *-- "1..*" VersionPresupuesto : conserva versiones
VersionPresupuesto "0..1" --> "0..1" VersionPresupuesto : versión anterior

note bottom of VersionPresupuesto
  Una sola versión vigente por presupuesto.
  La anterior pasa a histórica y sigue consultable
  con su archivo original (NF-05).
end note
@enduml
