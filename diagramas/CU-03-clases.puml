@startuml
!theme plain
skinparam style strictuml
title CU-03 · Cargar el presupuesto del cliente
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ERP" {
  class Obra {
    código: texto
    nombre: texto
    --
    + crearPresupuestoCliente(actor): PresupuestoCliente
  }
}

package "ECMS" {

  class "Presupuesto del cliente" as PresupuestoCliente {
    estado: EstadoPresupuestoCliente
    --
    + cargarArchivo(archivo): vacío
    + esArchivoRepetido(huella: texto): lógico
    + descartarCargaIncompleta(): vacío
    + agregarRubro(código, descripción): Rubro
    + identificarEstructura(): lógico
    + confirmarEstructura(): vacío
  }

  class "Archivo original" as ArchivoOriginal {
    nombre: texto {inmutable}
    tamañoBytes: entero {inmutable}
    huella: texto {inmutable}
    --
    + validarFormato(): lógico
    + guardar(): vacío
  }

  class Hoja {
    nombre: texto
    origen: detectada | manual
    columnas: lista de Columna
    rol: del cliente | ignorada
    --
    + definirColumna(índice, campo): vacío
    + ignorar(): vacío
  }

  class Rubro {
    código: texto
    descripción: texto
    --
    + agregarÍtem(código, descripción, unidad, cantidad, precio): ItemCliente
  }

  class "Ítem del cliente" as ItemCliente {
    código: texto
    descripción: texto
    unidad: texto
    cantidad: decimal
    precioUnitario: guaraníes
  }

  enum EstadoPresupuestoCliente <<enumeration>> {
    en_carga
    propuesta
    finalizado
  }
}

Obra "1" *-- "0..1" PresupuestoCliente : presupuesto contractual
PresupuestoCliente "1" *-- "0..1" ArchivoOriginal : conserva sin modificar
PresupuestoCliente "1" *-- "0..*" Hoja : estructura
PresupuestoCliente "1" *-- "1..*" Rubro : contiene
Rubro "1" *-- "1..*" ItemCliente : ítems cliente

PresupuestoCliente ..> EstadoPresupuestoCliente : estado

note bottom of Hoja
  Una hoja que no es del cliente (por ejemplo, la de costo)
  se ignora y se informa; no se confirma (3b).
end note

@enduml
