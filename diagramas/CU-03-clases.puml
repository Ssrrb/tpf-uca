@startuml
!theme plain
skinparam style strictuml
title CU-03 · Armar y versionar el presupuesto de costos
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Presupuesto de costos" as PresupuestoCostos {
    --
    + consultarVersiones(): lista de VersiónCostos
    + obtenerVigente(): VersiónCostos [0..1]
    + crearPrimeraVersión(base: PresupuestoCliente, actor): VersiónCostos
    + crearVersiónCorrectiva(motivo, actor): VersiónCostos
    + activar(versión, actor): vacío
  }

  enum EstadoVersionCostos <<enumeration>> {
    propuesta
    vigente
    historica
    descartada
  }

  class "Versión del presupuesto de costos" as VersionCostos {
    número: entero
    estado: EstadoVersionCostos
    motivo: texto [0..1]
    creadaPor: Usuario
    fecha: fecha y hora
    /costoPresupuestado: guaraníes
    --
    + copiarRubros(base: PresupuestoCliente): vacío
    + agregarRubroGastosGenerales(): vacío
    + completarÍtem(ítem, ejecutor, acu): vacío
    + calcularCosto(): guaraníes
    + validarDatos(): lista de texto
    + marcarVigente(actor): vacío
    + pasarAHistórica(): vacío
    + cancelar(): vacío
  }

  class "Rubro de costos" as RubroCostos {
    código: texto {estable}
    descripción: texto
    esGastosGenerales: lógico
  }

  class "Ítem de costos" as ItemCostos {
    código: texto {estable}
    unidad: texto
    cantidad: decimal
    ejecutor: propio | subcontratista
    --
    + estaCertificado(): lógico
    + definirEjecutor(ejecutor): vacío
    + calcularCostoPresupuestado(): guaraníes
  }

  class "Análisis de costo unitario" as ACU {
    --
    + calcularCostoUnitario(fecha): guaraníes
  }

  class "Línea de ACU" as LineaACU {
    tipo: material | mano de obra | equipo
    cantidadPorUnidad: decimal
    --
    + calcularCosto(fecha): guaraníes
  }

  class "Presupuesto del cliente" as PresupuestoCliente {
    estado: EstadoPresupuestoCliente
    --
    + obtenerRubros(): lista de Rubro
  }

  class "Apartado Adendas" as ApartadoAdendas {
    --
    + costoTotal(): guaraníes
  }
}

package "ERP" {
  class Insumo {
    código: texto
    unidad: texto
    --
    + obtenerPrecioVigente(fecha): guaraníes [0..1]
  }
}

PresupuestoCostos "1" *-- "1..*" VersionCostos : versiones
PresupuestoCostos "1" *-- "1" ApartadoAdendas : se suma a la vigente
VersionCostos "0..*" --> "1" PresupuestoCliente : se basa en
VersionCostos "0..1" --> "0..1" VersionCostos : versión anterior
VersionCostos "1" *-- "1..*" RubroCostos : contiene
RubroCostos "1" *-- "0..*" ItemCostos : agrupa
ItemCostos "1" *-- "0..1" ACU : análisis
ACU "1" *-- "1..*" LineaACU : insumos
LineaACU "0..*" --> "1" Insumo : usa

VersionCostos ..> EstadoVersionCostos : estado

note bottom of ItemCostos
  El código se conserva entre versiones y lo vincula
  con su ítem del presupuesto del cliente (RF-05).
end note

@enduml
