@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-14 · Estados del Documento pendiente
state saldo <<choice>>
state "Pendiente" as pendiente
state "Cancelado parcialmente" as parcial
state "Cancelado" as cancelado

[*] --> pendiente : registrarDocumento(origen: CU-08, CU-12 o fondo retenido)
pendiente --> saldo : confirmar(actor) [importe + retenciones <= saldo] / actualizarSaldo()
parcial --> saldo : confirmar(actor) [importe + retenciones <= saldo] / actualizarSaldo()
saldo --> parcial : [queda saldo pendiente]
saldo --> cancelado : [saldo = 0]
cancelado --> [*]

note right of cancelado
  Cada movimiento queda con importe, retenciones,
  fecha, medio, comprobantes, actor y la versión
  del certificado de la que deriva.
end note
@enduml
