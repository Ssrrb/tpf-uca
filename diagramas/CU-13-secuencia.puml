@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam sequenceMessageAlign center
skinparam maxMessageSize 210
skinparam ParticipantPadding 8
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ArrowColor #17324D
hide footbox
title CU-13 · Liquidar y derivar pago a subcontratista
actor "Ingeniero de obra" as Ingeniero
actor "Administrador" as Admin
control "motor:\nMotorIngenieria" as Motor
participant "version:\nVersionCertificado" as Version
participant "linea:\nLineaCertificado" as Linea
participant "contrato:\nContratoSubcontrato" as Contrato
participant "liquidacion:\nLiquidacionSubcontrato" as Liquidacion
actor "Sistema ERP" as ERP <<sistema>>

note over Ingeniero, Version
  Inicio: versión del certificado enviada a facturar (CU-07).
end note

Ingeniero -> Motor: obtenerContratosALiquidar(version)
Motor -> Version: obtenerLineasSubcontratadas(todas)
Version --> Motor: lineas: lista de LineaCertificado
loop Por cada línea subcontratada
  Motor -> Linea: obtenerContrato()
  Linea --> Motor: contrato: ContratoSubcontrato
end
Motor --> Ingeniero: líneas agrupadas por contrato

loop Por cada contrato a liquidar
  Ingeniero -> Motor: prepararLiquidacion(version, contrato)
  create Liquidacion
  Motor -> Liquidacion: «create» (version, contrato)
  Motor -> Version: obtenerLineasSubcontratadas(contrato)
  Version --> Motor: lineas: lista de LineaCertificado
  loop Por cada línea del contrato
    Motor -> Linea: estaLiquidada()
    Linea --> Motor: liquidada: lógico
    alt Ya liquidada en otra versión
      Motor --> Ingeniero: excluye la línea e informa la versión (RF-10)
    else Sin liquidar
      Motor -> Liquidacion: agregarLinea(linea)
    end
  end
  Motor -> Liquidacion: calcularImporte()
  Liquidacion --> Motor: importe: decimal
  Motor -> Contrato: verificarLimite(importe)
  Contrato --> Motor: dentroDelLimite: lógico
  alt Supera el límite del contrato
    Motor --> Ingeniero: informa e impide derivar este contrato
  else Dentro del límite
    Motor --> Admin: liquidación con cantidades y valorización
    alt El Administrador confirma
      Admin -> Motor: confirmarDerivacion(liquidacion)
      Motor -> ERP: enviarMedicionCertificada(contrato, lineas) (RF-25)
      alt El ERP rechaza o no responde
        ERP --> Motor: error
        Motor --> Admin: no se marca nada como liquidado; puede reintentar
      else Liquidación registrada
        ERP -> ERP: calcular monto con retenciones,\ndeducciones e impuestos del contrato
        ERP --> Motor: numero, montoAPagar
        Motor -> Liquidacion: registrarReferenciaERP(numero, montoAPagar)
        loop Por cada línea incluida
          Motor -> Linea: marcarLiquidada(liquidacion)
        end
        Motor -> Contrato: actualizarSaldo(montoAPagar)
        Motor --> Admin: liquidación pendiente de pago en tesorería (CU-15)
      end
    else No confirma
      Motor --> Admin: no se envía nada al ERP
    end
  end
end
note over Motor, Contrato
  El subcontratista ve el saldo actualizado en su portal (CU-09).
end note
@enduml
