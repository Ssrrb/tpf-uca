@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-13 · Consultar tablero financiero
actor "Administrador\n(o Finanzas y tesorería)" as Adm
box "Motor de finanzas" #EAF2F6
participant "tablero:\nTablero" as Tab
participant "libro:\nLibroFinanciero" as Lib
participant "total:\nTotalTablero" as Tot
end box
box "ERP" #EAF2F6
participant "usuario:\nUsuario" as Usr
participant "obra:\nObra" as Obra
end box
box "ECMS" #EAF2F6
participant "resumen:\nResumenObra" as Res
end box

Adm -> Tab: consultar(alcance, usuario)
loop por cada obra del alcance
  Tab -> Usr: tieneAcceso(obra)
  Usr --> Tab: acceso: lógico
  opt sin acceso a la obra (1b)
    Tab --> Adm: excluye sus datos y lo indica
  end
  Tab -> Res: presupuestado(obra)
  Res --> Tab: a costo (con apartado Adendas) y a venta (cliente + adendas)
  break falla la lectura de los datos de obra (3a)
    Tab --> Adm: los marca no disponibles con la fecha del último dato
  end
  Tab -> Res: certificadoPorRubro(obra, fecha)
  Tab -> Res: avanceFísico(obra, fecha)
  Tab -> Obra: plazoTranscurrido(fecha)
  Tab -> Lib: totales(obra, fecha)
  Lib --> Tab: facturado, cobrado, pagado y saldos
  Tab -> Lib: resultadoEconómico(obra, fecha)
  Tab -> Lib: resultadoFinanciero(obra, fecha)
  create Tot
  Tab -> Tot: «create»(concepto, importe, fecha, unidad, PYG, procedencia)
end
Tab --> Adm: totales por obra y empresa, avance físico y plazo\ntranscurrido en porcentaje (RF-28, NF-11)
opt filtra por rubro o fecha (1a)
  Adm -> Tab: filtrar(rubro, fecha)
end
Adm -> Tab: abrirRespaldo(total)
Tab --> Adm: versión del presupuesto o del certificado, factura interna\ncon la legal, recibo o comprobante (NF-12)
opt exporta (6a, RF-18)
  Adm -> Tab: exportar(formato)
end
@enduml
