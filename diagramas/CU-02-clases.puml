@startuml
!theme plain
skinparam style strictuml
title CU-02 · Mantener catálogos
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ERP" {
  class "Catálogo" as Catalogo {
    --
    + listar(filtro): lista de texto
    + rucDisponible(ruc: texto): lógico
    + crearProveedor(ruc, razónSocial): Proveedor
    + crearCliente(ruc, razónSocial): Cliente
  }

  class Proveedor {
    tipo: texto {subcontratista}
    ruc: texto
    razónSocial: texto
    activo: lógico
    --
    + modificar(datos): vacío
    + darDeBaja(actor): vacío
  }

  class Cliente {
    ruc: texto
    razónSocial: texto
    activo: lógico
    --
    + modificar(datos): vacío
    + darDeBaja(actor): vacío
  }
}

Catalogo "1" o-- "0..*" Proveedor : empresas subcontratistas
Catalogo "1" o-- "0..*" Cliente : clientes

note bottom of Catalogo
  En los dos el código es el RUC. Los insumos, los equipos y la
  mano de obra, con sus precios, quedan fuera del MVP.
end note
@enduml
