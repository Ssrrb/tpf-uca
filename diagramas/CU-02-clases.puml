@startuml
!theme plain
skinparam style strictuml
title CU-02 · Crear y validar el presupuesto del cliente
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class Obra {
    código: texto
    nombre: texto
    --
    + crearPresupuestoCliente(actor): PresupuestoCliente
    + vincularPresupuestoCliente(presupuesto): vacío
  }

  class "Presupuesto del cliente" as PresupuestoCliente {
    estado: EstadoPresupuestoCliente
    totalDeclarado: guaraníes [0..1]
    totalRecalculado: guaraníes
    /diferenciaTotal: guaraníes [0..1]
    finalizadoPor: Usuario [0..1]
    fechaFinalización: fecha y hora [0..1]
    --
    + cargarArchivo(archivo): vacío
    + esArchivoRepetido(huella: texto): lógico
    + descartarCargaIncompleta(): vacío
    + agregarRubro(código, descripción): Rubro
    + identificarEstructura(): lógico
    + confirmarEstructura(): vacío
    + validarDatos(): Informe de importación
    + recalcularTotales(): guaraníes
    + compararTotales(): Informe de importación
    + finalizar(actor): vacío
  }

  class "Archivo original" as ArchivoOriginal {
    nombre: texto {inmutable}
    tamañoBytes: entero {inmutable}
    huella: texto {inmutable}
    --
    + validarFormato(): lógico
    + guardar(): vacío
  }

  class Hoja {
    nombre: texto
    origen: detectada | manual
    --
    + definirColumna(índice, campo): Columna
    + validarFilas(informe): vacío
  }

  class Columna {
    encabezado: texto
    campoDestino: texto
    obligatoria: lógico
    --
    + validarValor(valor: texto): lógico
  }

  class Rubro {
    código: texto
    descripción: texto
    totalDeclarado: guaraníes [0..1]
    --
    + agregarÍtem(código, descripción, unidad, cantidad, precio): Ítem
    + recalcularTotal(): guaraníes
  }

  class "Ítem" as Item {
    código: texto
    descripción: texto
    unidad: texto
    cantidad: decimal
    precioUnitario: guaraníes
    /total: guaraníes
    --
    + recalcularTotal(): guaraníes
  }

  class "Informe de importación" as InformeImportacion {
    fecha: fecha y hora
    diferenciasAceptadas: lógico
    --
    + registrarError(hoja, fila, columna, motivo): vacío
    + registrarDiferencia(rubro, declarado, recalculado): vacío
    + aceptarDiferencias(): vacío
  }

  enum EstadoPresupuestoCliente {
    propuesta
    finalizado
  }
}

Obra "1" *-- "0..1" PresupuestoCliente : presupuesto contractual
PresupuestoCliente "1" *-- "0..1" ArchivoOriginal : conserva sin modificar
PresupuestoCliente "1" *-- "0..*" Hoja : estructura identificada
Hoja "1" *-- "1..*" Columna : define
PresupuestoCliente "1" *-- "1..*" Rubro : contiene
Rubro "1" *-- "1..*" Item : agrupa
PresupuestoCliente "1" *-- "0..*" InformeImportacion : informes de carga
Item "0..*" --> "0..1" Hoja : fila de origen

note bottom of PresupuestoCliente
  Finalizado queda inmutable (RN-01): los cambios van
  por el presupuesto de costos (CU-03) o por adendas (CU-11).
  Mismo XLSX sin cambios: no se crea otra carga (NF-07).
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
