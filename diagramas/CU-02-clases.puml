@startuml
!theme plain
skinparam style strictuml
title CU-02 · Cargar el presupuesto del cliente
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ERP" {
  class Obra {
    código: texto
    nombre: texto
    --
    + crearPresupuestoCliente(actor): PresupuestoCliente
  }
}

package "ECMS" {

  class "Presupuesto del cliente" as PresupuestoCliente {
    estado: EstadoPresupuestoCliente
    --
    + cargarArchivo(archivo): vacío
    + esArchivoRepetido(huella: texto): lógico
    + descartarCargaIncompleta(): vacío
    + agregarRubro(código, descripción): Rubro
    + identificarEstructura(): lógico
    + confirmarEstructura(): vacío
  }

  class "Archivo original" as ArchivoOriginal {
    nombre: texto {inmutable}
    tamañoBytes: entero {inmutable}
    huella: texto {inmutable}
    --
    + validarFormato(): lógico
    + guardar(): vacío
  }

  class Hoja {
    nombre: texto
    origen: detectada | manual
    columnas: lista de Columna
    --
    + definirColumna(índice, campo): vacío
  }

  class Rubro {
    código: texto
    descripción: texto
    ítems: lista de Item
    --
    + agregarÍtem(código, descripción, unidad, cantidad, precio): vacío
  }

  enum EstadoPresupuestoCliente <<enumeration>> {
    propuesta
    finalizado
  }
}

Obra "1" *-- "0..1" PresupuestoCliente : presupuesto contractual
PresupuestoCliente "1" *-- "0..1" ArchivoOriginal : conserva sin modificar
PresupuestoCliente "1" *-- "0..*" Hoja : estructura identificada
PresupuestoCliente "1" *-- "1..*" Rubro : contiene

PresupuestoCliente ..> EstadoPresupuestoCliente : estado

@enduml
