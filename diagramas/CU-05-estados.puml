@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-05 · Estados de la Versión del presupuesto de costos
state "Vigente" as vigente
state "Histórica" as historica

[*] --> vigente : guardarPrimeraVersión(base, actor) o guardarVersión(cambios, motivo, actor)
vigente --> historica : guardarVersión(cambios, motivo, actor) de la versión siguiente / pasarAHistórica()
historica --> [*]

note right of historica
  Sigue consultable con los certificados
  que la usaron (NF-04).
end note

note right of vigente
  Hay una sola vigente por obra. No hay
  versión propuesta que se complete, se
  active o se cancele en el MVP.
end note
@enduml
