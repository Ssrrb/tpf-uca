@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-09 · Liquidar subcontratista
actor "Ingeniero de obra" as Ing
box "ECMS" #EAF2F6
participant "version:\nVersionCertificado" as V
participant "medicion:\nMedicion" as Med
end box
box "ERP" #EAF2F6
participant "contrato:\nContrato" as Con
participant "itemContrato:\nItemContrato" as IC
participant "retencion:\nRetencion" as Ret
end box
box "Motor de finanzas" #EAF2F6
participant "liquidaciones:\nRegistroLiquidacion" as Mot
participant "liquidacion:\nLiquidacion" as Liq
participant "detalle:\nDetalleLiquidacion" as Det
participant "deduccion:\nDeduccion" as Ded
end box

loop por cada contrato de la versión (1a)
  Ing -> V: medicionesSinLiquidar(contrato)
  loop por cada medición del contrato certificada en la versión o en una anterior
    V -> Med: estaLiquidada()
    Med --> V: liquidada: lógico
  end
  V -> Con: alcance()
  Con --> V: ítems del contrato
  loop por cada ítem del contrato
    V -> IC: datos()
    IC --> V: cantidad, precio y límite
  end
  V -> V: controlarLímites(alcance, mediciones)
  V --> Ing: cantidades sin liquidar y, si un ítem pasa su cantidad\no su límite en el contrato, el aviso (2a)
  alt confirma la liquidación (paso 3)
    Ing -> V: liquidarSubcontratista(contrato, actor)
    V -> Con: condiciones()
    loop por cada retención del contrato
      Con -> Ret: datos()
      Ret --> Con: tipo y porcentaje
    end
    Con --> V: fondo de reparo, IVA y retenciones
    V -> Mot: liquidar(version, contrato, mediciones, alcance, condiciones)
    Mot -> Mot: buscar(version, contrato)
    alt ya existe (reintento, NF-02)
      Mot --> V: la liquidación existente; no se duplica
    else no existe
      create Liq
      Mot -> Liq: «create»(version, contrato, mediciones)
      Mot -> Liq: calcular(alcance, condiciones)
      Liq -> Liq: armarDetalle(mediciones, alcance)
      loop por cada ítem del contrato con cantidad certificada
        create Det
        Liq -> Det: «create»(ítem, cantidad)
        Liq -> Det: calcularImporte()
      end
      Liq -> Liq: aplicarDeducciones(condiciones)
      loop por cada deducción (fondo de reparo, retención de IVA, retención de renta, IVA)
        create Ded
        Liq -> Ded: «create»(tipo)
        Liq -> Ded: calcularImporte(base)
      end
      note right of Liq
        Al precio del contrato: bruto, fondo de reparo,
        neto, IVA y retenciones; queda lo que se paga.
        Se registra una vez y no cambia (RF-16, §6.3).
      end note
      Mot --> V: liquidación registrada
    end
    break falla el registro en el Motor de finanzas (4a)
      V --> Ing: no se marca ninguna cantidad; se puede reintentar
    end
    loop por cada medición liquidada
      V -> Med: marcarLiquidada(liquidacion)
    end
    V --> Ing: liquidación registrada; el pago ocurre fuera del sistema
  else no confirma
    V --> Ing: no se registra nada; las cantidades quedan sin liquidar
  end
end
@enduml
