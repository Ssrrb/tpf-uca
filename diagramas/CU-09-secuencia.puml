@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-09 · Registrar contrato de subcontratista
actor "Administrador" as Admin
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
participant "subcontratista:\nProveedor" as Prov
participant "contrato:\nContrato" as Con
participant "itemContrato:\nItemContrato" as IC
participant "retencion:\nRetencion" as Ret
end box
box "ECMS" #EAF2F6
participant "saldo:\nSaldoItem" as Saldo
participant "item:\nItemCostos" as Item
end box

Admin -> Obra: registrarContrato(subcontratista, número, fechas, archivo)
Obra -> Prov: esSubcontratista()
Prov --> Obra: sí
Obra -> Obra: númeroContratoDisponible(número)
break el número ya existe en la obra (5b)
  Obra --> Admin: pide otro número (vuelve al paso 2)
end
create Con
Obra -> Con: «create»(subcontratista, número, fechas, archivo)
Con -> Con: validarArchivo()
break falta el archivo o el formato no está permitido (5c)
  Con --> Admin: impide confirmar (vuelve al paso 2)
end
loop por cada ítem del alcance
  Admin -> Con: agregarÍtem(ítem, precio, límite)
  Con -> Saldo: cantidadPresupuestada()
  Saldo --> Con: presupuestada
  Con -> Saldo: disponibleParaContratos()
  Saldo --> Con: disponible
  alt el límite supera lo presupuestado (5a)
    Con --> Admin: rechaza el ítem e informa el exceso
  else la cantidad ya está asignada a otro contrato (5d, RF-10)
    Con --> Admin: lo informa para evitar el doble conteo
  else válido
    create IC
    Con -> IC: «create»(ítem, precio, límite)
  end
end
Admin -> Con: configurarCondiciones(impuestos, retenciones, fondoReparo)
loop por cada retención
  create Ret
  Con -> Ret: «create»(tipo, porcentaje)
end
Admin -> Con: confirmar(actor)
loop por cada ítem del contrato
  Con -> Saldo: reservarParaContrato(cantidad)
end
Con --> Admin: contrato guardado y vinculado al alcance (RF-23)
note over Item, Saldo
  El saldo es del ítem de costos (código estable, RN-02).
end note
@enduml
