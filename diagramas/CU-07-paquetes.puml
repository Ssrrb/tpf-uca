@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-07 · Paquetes ECMS y ERP
package "ECMS" {
  package "certifications" as cert {
}
  package "budgets" as bud {
}
  package "subcontracts" as subc {
}
  package "uploads" as upl {
}
  package "cost-control" as cc {
}
}
rectangle "«bridge»\nPuente de eventos ECMS–ERP" as bridge
package "ERP" {
  package "invoices" as inv {
}
  package "payments" as pay {
}
  package "finance" as fin {
}
  package "dashboard" as dash {
}
  package "catalogs" as cat {
}
}
cert ..> bud : <<use>>
cert ..> subc : <<use>>
cert ..> upl : <<use>>
cc ..> cert : <<use>>
cert ..> bridge : <<event>>\nVersionCertificadoEnviada
subc ..> bridge : <<event>>\nMedicionCertificada
bridge ..> inv : <<event>>
bridge ..> pay : <<event>>
pay ..> inv : <<use>>
fin ..> pay : <<use>>
dash ..> fin : <<use>>
inv ..> cat : <<use>>
note bottom of bridge
  Las dependencias entre ECMS y ERP
  pasan solo por el puente de eventos (PR-05).
end note
@enduml
