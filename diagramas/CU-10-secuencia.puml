@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-10 · Controlar el costo de la obra con el ACU
actor "Ingeniero de obra\n(o Administrador)" as Ing
box "ECMS" #EAF2F6
participant "control:\nControlCostos" as Ctrl
participant "vigente:\nVersionCostos" as VC
participant "apartado:\nApartadoAdendas" as Apa
participant "item:\nItemCostos" as Item
participant "medicion:\nMedicion" as Med
participant "acu:\nACU" as Acu
participant "linea:\nLineaControl" as Lin
end box
box "ERP" #EAF2F6
participant "insumo:\nInsumo" as Ins
end box
box "Motor de finanzas" #EAF2F6
participant "costos:\nCostosReales" as CR
participant "gasto:\nGasto" as G
end box

Ing -> Ctrl: consultar(obra, fechaConsulta)
Ctrl -> VC: obtenerÍtems()
VC --> Ctrl: ítems con su ACU
loop por cada ítem con mediciones hasta la fecha
  Ctrl -> Med: consumosHasta(fecha)
  Med --> Ctrl: insumos consumidos
end
Ctrl -> CR: gastosPorRubro(obra, fecha)
CR --> Ctrl: gastos imputados por rubro (RF-21)
Ctrl -> CR: liquidacionesHasta(obra, fecha)
CR --> Ctrl: liquidaciones de subcontratistas (RF-16)
break no hay mediciones ni gastos hasta la fecha (1b)
  Ctrl --> Ing: lo informa; el CU termina
end

loop por cada ítem
  Ctrl -> Item: calcularCostoPresupuestado()
  Ctrl -> Apa: costoPorÍtem(ítem)
  alt ítem propio
    Ctrl -> Acu: costoConsumido(consumos, fecha)
    loop por cada insumo consumido
      Acu -> Ins: obtenerPrecioVigente(fecha)
      Ins --> Acu: precio [0..1]
    end
    break insumo sin precio vigente
      Acu --> Ing: informa el insumo; no calcula ese rubro
    end
  else ítem subcontratado
    note right of Ctrl
      Costo = lo liquidado al precio del contrato.
    end note
  end
  create Lin
  Ctrl -> Lin: «create»(presupuestado, consumido, liquidado, comprado)
end
Ctrl --> Ing: por rubro e ítem: presupuestado, consumido según ACU,\nliquidado, comprado, acopio, desvío, diferencias y saldo,\nincluidos los rubros en negativo (RF-17)

opt filtra por rubro, ejecutor o tipo de gasto (1a)
  Ing -> Ctrl: filtrar(criterio)
end
Ing -> Ctrl: verRespaldo(total)
alt el total sale de mediciones
  Ctrl -> Med: verEvidencia()
else el total sale de gastos
  Ctrl -> G: verComprobante()
end
Ctrl --> Ing: respaldo (NF-11)
note over Ing, Lin
  5a: si la diferencia muestra un ACU mal estimado,
  el Ingeniero lo corrige en una versión nueva (CU-03).
end note
@enduml
