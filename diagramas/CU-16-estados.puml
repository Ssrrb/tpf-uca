@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-16 · Estados del Presupuesto del cliente
state origen <<choice>>
state "En carga" as en_carga
state "Propuesta" as propuesta
state "Finalizado" as finalizado

[*] --> origen : crearPresupuestoCliente(actor)
origen --> en_carga : [con XLSX] / cargarArchivo(archivo)
origen --> propuesta : [sin XLSX] / agregarRubro(código, descripción)
en_carga --> propuesta : confirmarEstructura() [XLSX válido y no repetido]
en_carga --> [*] : [archivo rechazado o repetido] / descartarCargaIncompleta()
propuesta --> en_carga : cargarArchivo(archivo) [recarga]
propuesta --> propuesta : validarDatos() [hay datos inválidos]
propuesta --> finalizado : finalizar(actor) [datos válidos] / vincularPresupuestoCliente()
finalizado --> [*]

note right of en_carga
  En carga y Propuesta se recorren
  en CU-02; la validación y la
  finalización, en CU-16.
end note

@enduml
