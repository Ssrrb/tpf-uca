@startuml
!theme plain
skinparam style strictuml
title CU-01 · Gestionar obra
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
left to right direction

package "ERP" {
  class "Organización" as Organizacion {
    nombre: texto
    --
    + códigoDisponible(código: texto): lógico
    + crearObra(datos, miembros, actor): Obra
  }

  class Usuario {
    nombre: texto
    correo: texto
    rol: texto {Administrador | Ingeniero de obra}
    --
    + obtenerRol(organización): texto [0..1]
    + perteneceA(organización): lógico
  }

  class Cliente {
    razónSocial: texto
    ruc: texto
    activo: lógico
    --
    + estaActivo(): lógico
  }

  class Obra {
    código: texto
    nombre: texto
    fechaInicio: fecha
    fechaFin: fecha
    fechaFinVigente: fecha
    porcentajeIVA: decimal
    porcentajeFondoReparo: decimal [0..1]
    estado: EstadoObra
    registradaPor: Usuario
    fechaRegistro: fecha y hora
    --
    + validarDatos(): lista de texto
    + definirAnticipo(modalidad, valor): Anticipo
    + asignarMiembro(usuario, rol, permisos): Asignacion
    + avanzarEstado(actor): EstadoObra
  }

  class Anticipo {
    modalidad: porcentaje | importe
    valor: decimal
  }

  class "Asignación" as Asignacion {
    rol: texto {Administrador | Ingeniero de obra}
    permisos: lista de texto
    fechaAsignación: fecha y hora
  }

  class "Cambio de estado" as CambioEstado {
    desde: EstadoObra
    hasta: EstadoObra
    actor: Usuario
    fecha: fecha y hora
  }

  enum EstadoObra <<enumeration>> {
    en_ejecucion
    recepcion_provisoria
    recepcion_definitiva
    cerrada
  }
}

Organizacion "1" *-- "0..*" Obra : tiene
Organizacion "1" o-- "0..*" Usuario : tiene
Obra "0..*" --> "1" Cliente : contratada por
Obra "1" *-- "0..1" Anticipo : configura
Obra "1" *-- "0..*" Asignacion : miembros
Asignacion "0..*" --> "1" Usuario : asigna a
Obra "1" *-- "0..*" CambioEstado : historial

Obra ..> EstadoObra : estado

note right of EstadoObra
  La pantalla muestra tres estados sobre estos cuatro:
  Activa (en_ejecucion), En recepción (recepcion_provisoria
  o recepcion_definitiva) y Cerrada (cerrada).
end note

@enduml
