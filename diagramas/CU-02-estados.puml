@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-02 · Estados de la Versión de presupuesto
[*] --> en_carga : Presupuesto.crearVersion(archivo)
en_carga --> pendiente_estructura : ArchivoOriginal.guardarOriginal()\n[guardado completo]
en_carga --> descartada : descartarCargaIncompleta()\n[falla de almacenamiento o interrupción]
pendiente_estructura --> pendiente_validacion : confirmarEstructura()\n[estructura válida]
pendiente_validacion --> con_errores : validarDatos()\n[datos obligatorios inválidos]
pendiente_validacion --> pendiente_aceptacion : validarDatos()\n[sin datos inválidos] / recalcularTotales()
pendiente_aceptacion --> aceptada : aceptarResultado(aceptarDiferencias)
aceptada --> disponible : Presupuesto.publicarVersion(version)
pendiente_estructura --> cancelada : cancelar()
pendiente_aceptacion --> cancelada : cancelar()
con_errores --> [*]
cancelada --> [*]
descartada --> [*]
disponible --> [*] : se activa en CU-03
note right of con_errores
  Cada error indica hoja, fila y columna (RF-03).
  Corregir exige cargar otra vez el archivo.
end note
@enduml
