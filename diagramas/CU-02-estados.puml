@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-02 · Estados del Presupuesto del cliente
state origen <<choice>>
state "En carga" as en_carga
state "Propuesta" as propuesta
state "Finalizado" as finalizado

[*] --> origen : crearPresupuestoCliente(actor)
origen --> en_carga : [con XLSX] / cargarArchivo(archivo)
origen --> propuesta : [sin XLSX (1a)] / agregarRubro(código, descripción)
en_carga --> propuesta : guardar() [XLSX válido y no repetido]
en_carga --> [*] : [archivo rechazado, repetido o carga interrumpida] / descartarCargaIncompleta()
propuesta --> en_carga : cargarArchivo(archivo) [recarga]
propuesta --> propuesta : confirmarEstructura() / validarDatos()
propuesta --> finalizado : finalizar(actor) [estructura confirmada y datos válidos] / vincularPresupuestoCliente()
finalizado --> [*]

note right of finalizado
  Inmutable (RN-01). Es la base
  del presupuesto de costos (CU-03).
end note
@enduml
