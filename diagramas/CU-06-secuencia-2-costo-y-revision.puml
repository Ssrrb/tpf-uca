@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam sequenceMessageAlign center
skinparam maxMessageSize 210
skinparam ParticipantPadding 8
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ArrowColor #17324D
hide footbox
title CU-06 · 2/2 · Costo del rubro, revisión y guardado
actor "Ingeniero de obra" as Ingeniero
control "motor:\nMotorIngenieria" as Motor
participant "obra:\nObra" as Obra
participant "presupuestoCostos:\nVersionPresupuestoCostos" as PresCostos
participant "rubro:\nRubro" as Rubro
participant "costoRubro:\nCostoRubro" as CostoRubro
participant "costoItem:\nCostoItem" as CostoItem
participant "medicion:\nMedicionAvance" as Medicion
participant "consumo:\nConsumoInsumo" as Consumo
participant "insumo:\nInsumo" as Insumo
participant "acu:\nAnalisisCostoUnitario" as ACU
participant "version:\nVersionCertificado" as Certificado

note over Ingeniero, Certificado
  Inicio: versión del certificado generada y valorizada en 1/2, a la misma fecha.
end note

Motor -> Motor: calcularCostoAvance(obra, fecha)
Motor -> Obra: obtenerPresupuestoCostosVigente()
Obra --> Motor: presupuestoCostos: VersionPresupuestoCostos
note right of PresCostos
  Versión vigente con sus adendas aprobadas.
end note
Motor -> PresCostos: obtenerRubros()
PresCostos --> Motor: rubros: lista de Rubro
loop Por cada rubro
  create CostoRubro
  Motor -> CostoRubro: «create» (rubro, fecha)
  Motor -> Rubro: obtenerItems()
  Rubro --> Motor: items: lista de ItemPresupuesto
  loop Por cada ítem con avance
    Motor -> CostoRubro: agregarCostoItem(item)
    create CostoItem
    CostoRubro -> CostoItem: «create» (item)
    CostoItem --> CostoRubro: costoItem
    loop Por cada medición del ítem hasta la fecha
      Motor -> Medicion: obtenerConsumos()
      Medicion --> Motor: consumos: lista de ConsumoInsumo
      loop Por cada consumo (material, mano de obra o equipo)
        Motor -> Consumo: calcularCosto(fecha)
        Consumo -> Insumo: obtenerPrecioVigente(fecha)
        Insumo --> Consumo: precio: decimal [0..1]
        Consumo --> Motor: importe: decimal [0..1]
        alt Insumo con precio vigente
          Motor -> CostoItem: sumarConsumo(tipoInsumo, importe)
        else Insumo sin precio vigente
          Motor -> Certificado: señalar(insumo_sin_precio, insumo, origen)
          note right of CostoRubro
            calculado = falso: el costo de este
            rubro no se calcula hasta completarlo.
          end note
        end
      end
    end
    Motor -> CostoItem: calcularCostoPresupuestado(acu)
    CostoItem -> ACU: calcularCostoUnitario(fecha)
    ACU --> CostoItem: costoUnitario: decimal
    CostoItem --> Motor: costoPresupuestado: decimal
  end
  Motor -> CostoRubro: calcularDiferencia()
  CostoRubro --> Motor: diferencia: decimal
end

Motor --> Ingeniero: versión del certificado, costo por rubro e ítem y señalamientos (RF-15)

note over Ingeniero, Certificado
  Señalamientos: excesos, mediciones faltantes, precios sin movimiento vigente
  y diferencias de totales, cada uno con su dato de origen.
end note

opt El ingeniero revisa los señalamientos
  Ingeniero -> Certificado: obtenerSenalamientos()
  Certificado --> Ingeniero: señalamientos con tipo y dato de origen
end

Ingeniero -> Motor: guardarCertificado(version)
Motor -> Certificado: guardar()
note right of Certificado
  Guarda la versión con sus respaldos:
  presupuesto de costos y adendas, mediciones
  y documentos usados (NF-12). No modifica
  el presupuesto del cliente.
end note
Certificado --> Motor: guardado

Motor --> Ingeniero: versión guardada como última versión
note over Ingeniero, Motor
  El certificado no tiene estados: la versión guardada
  se puede retomar para generar una versión nueva.
end note

opt El ingeniero envía la versión para facturar
  ref over Ingeniero, Certificado
    Enviar a facturar la versión del certificado (CU-07).
  end ref
end
@enduml
