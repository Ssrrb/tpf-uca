@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam sequenceMessageAlign center
skinparam maxMessageSize 210
skinparam ParticipantPadding 8
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ArrowColor #17324D
hide footbox
title CU-06 · 1/2 · Generar y valorizar el certificado
actor "Ingeniero de obra" as Ingeniero
control "motor:\nMotorIngenieria" as Motor
participant "obra:\nObra" as Obra
participant "medicion:\nMedicionAvance" as Medicion
participant "item:\nItemPresupuesto" as Item
participant "certificadoObra:\nCertificadoObra" as CertObra
participant "version:\nVersionCertificado" as Certificado
participant "linea:\nLineaCertificado" as Linea

Ingeniero -> Motor: generarCertificacion(obra, desdeUltimaVersion)
Motor -> Obra: obtenerCertificado()
Obra --> Motor: certificadoObra: CertificadoObra
Motor -> CertObra: crearVersion(desdeUltimaVersion)
alt Desde la última versión
  CertObra -> CertObra: obtenerUltimaVersion()
  create Certificado
  CertObra -> Certificado: «create» (copia líneas de la última versión, numero + 1)
else Desde cero
  create Certificado
  CertObra -> Certificado: «create» (obra, fecha)
end
CertObra --> Motor: version: VersionCertificado
note right of CertObra
  Un solo certificado por obra, sin estados.
  Cada versión se puede retomar y modificar.
end note

Motor -> Obra: obtenerMedicionesSinCertificar(fecha)
Obra --> Motor: mediciones: lista de MedicionAvance
note right of Obra
  Mediciones registradas hasta la fecha con cantidad
  aún no certificada, incluido el exceso que liberó
  una adenda aprobada (CU-12).
end note

break No hay cantidades nuevas para certificar
  Motor --> Ingeniero: aviso: no hay mediciones para certificar
end

loop Por cada medición con cantidad sin certificar
  Motor -> Medicion: obtenerCantidadCertificable()
  Medicion --> Motor: cantidad: decimal
  note right of Medicion
    Solo el remanente no certificado en versiones
    anteriores. Incluye mediciones propias y
    subcontratadas. Excluye cantidadExcedidaPendiente
    (exceso sin adenda aprobada).
  end note
end

loop Por cada ítem con cantidad certificable
  Motor -> Item: obtenerPrecioVentaVigente(fecha)
  Item --> Motor: precio: decimal [0..1]
  note right of Item
    Precio de la versión vigente del presupuesto
    de costos con sus adendas aprobadas
    (tieneMovimientoVigente).
  end note
  Motor -> Item: tieneMovimientoVigente(fecha)
  Item --> Motor: vigente: lógico
  alt Hay precio de venta y movimiento vigente
    Motor -> Certificado: agregarLinea(item, cantidad, precio)
    create Linea
    Certificado -> Linea: «create» (item, cantidad, precio)
    Linea -> Linea: calcularImporte()
    Linea --> Certificado: linea
  else Sin precio de venta o sin movimiento vigente
    Motor -> Certificado: señalar(precio_sin_movimiento_vigente, item, origen)
  end
end

Motor -> Certificado: tieneBloqueos()
Certificado --> Motor: bloqueado: lógico
break bloqueado = verdadero
  Motor --> Ingeniero: ítems señalados con su dato de origen; no se puede continuar
end

Motor -> Obra: obtenerPorcentajeImpuestos()
Obra --> Motor: porcentajeImpuestos: decimal
Motor -> Obra: obtenerPorcentajeFondoRetencion()
Obra --> Motor: porcentajeFondo: decimal
Motor -> Certificado: aplicarImpuestosYFondos(porcentajeImpuestos, porcentajeFondo)
Certificado -> Certificado: calcularTotales()

ref over Ingeniero, Linea
  Continúa en 2/2: costo del rubro, revisión y guardado.
end ref
@enduml
