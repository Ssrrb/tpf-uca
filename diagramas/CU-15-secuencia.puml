@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-15 · Cargar presupuesto de adendas del cliente
actor "Ingeniero de obra" as Ing
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
end box
box "ECMS" #EAF2F6
participant "presupuesto:\nPresupuestoAdendas" as PA
participant "linea:\nLineaPresupuestoAdendas" as Lin
participant "item:\nItemCostos" as Item
end box

Ing -> Obra: presupuestosDeAdendas()
Obra --> Ing: presupuestos de adendas ya cargados (RF-06)
Ing -> Obra: siguienteNúmeroAdendas()
Obra --> Ing: número
create PA
Ing -> PA: «create»(número, fecha)
alt carga desde el XLSX del cliente (paso 2)
  Ing -> PA: importar(archivo)
  note right of PA
    Conserva el archivo original y propone
    las líneas que lee (como RF-02 y RF-03).
  end note
else carga manual (2a)
  loop por cada línea del documento
    Ing -> PA: agregarLínea(ítem, descripción, unidad, cantidad, precioVenta)
  end
end
loop por cada línea propuesta o cargada
  create Lin
  PA -> Lin: «create»(ítem, descripción, unidad, cantidad, precioVenta)
  Lin -> Item: buscar(código)
  Item --> Lin: ítem existente [0..1]
  opt no existe en el presupuesto de costos (3a)
    Lin -> Lin: esÍtemNuevo()
    note right of Lin
      Ítem nuevo: se crea al registrar
      la adenda que lo aprueba (CU-11).
    end note
  end
end
PA --> Ing: líneas con importe y total (paso 3)

alt confirma (paso 4)
  Ing -> PA: guardar(actor)
  PA -> PA: validar()
  break falta un dato obligatorio o el número ya existe (4b)
    PA --> Ing: marca cada error (vuelve al paso 3)
  end
  PA --> Ing: presupuesto cargado con actor y fecha;\nlisto para registrar adendas (CU-11)
else cancela (4a)
  Ing -> PA: cancelar()
  PA --> Ing: no se guarda; los cargados no cambian
end
@enduml
