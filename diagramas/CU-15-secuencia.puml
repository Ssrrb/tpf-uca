@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-15 · Emitir presupuesto de adendas
actor "Ingeniero de obra" as Ing
box "ECMS" #EAF2F6
participant "presupuesto:\nPresupuestoAdendas" as PA
participant "apartado:\nApartadoAdendas" as Apa
participant "version:\nVersionAdendas" as V
participant "anterior:\nVersionAdendas" as Ant
participant "linea:\nLineaAdenda" as Lin
end box

Ing -> PA: versiones()
PA --> Ing: versión vigente y anteriores (RF-06)
opt solo quiere una versión anterior (2a)
  Ing -> Ant: exportar(formato)
  Ant --> Ing: XLSX o PDF; el CU termina
end

Ing -> PA: emitirVersión(actor)
PA -> PA: hayCambios()
break no hay adendas nuevas ni cambios (4a)
  PA --> Ing: lo informa; no se crea versión
end
PA -> Apa: adendasRegistradas()
Apa --> PA: adendas con su precio de venta acordado
create V
PA -> V: «create»(número siguiente, anterior)
PA -> V: armar(adendas)
loop por cada adenda registrada
  create Lin
  V -> Lin: «create»(adenda, descripción, precioVenta)
end
V --> Ing: versión en edición (RF-21)

opt corrige la descripción de una adenda (paso 5)
  Ing -> V: corregirLínea(línea, descripción, motivo)
  V -> Lin: corregir(descripción, motivo)
end

alt confirma (paso 6)
  Ing -> V: guardar(actor)
  V -> V: validarMotivos()
  break falta el motivo de una corrección (6b)
    V --> Ing: marca el campo (vuelve al paso 5)
  end
  V -> PA: activar(version)
  PA -> Ant: pasarAAnterior()
  V --> Ing: versión vinculada a la anterior, con actor y fecha (NF-05)
  opt exporta para enviarla al cliente (7a, PR-04)
    Ing -> V: exportar(formato)
  end
else cancela (6a)
  Ing -> V: cancelar()
  V --> Ing: no se crea versión; la vigente no cambia
end
@enduml
