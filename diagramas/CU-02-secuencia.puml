@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-02 · Mantener catálogos
actor "Administrador" as Admin
box "ERP" #EAF2F6
participant "catalogo:\nCatalogo" as Cat
participant "proveedor:\nProveedor" as Prov
participant "cliente:\nCliente" as Cli
end box

Admin -> Cat: listar(filtro)
Cat --> Admin: lista paginada por RUC y razón social

alt crear una empresa subcontratista o un cliente (paso 2)
  alt empresa subcontratista
    Admin -> Cat: crearProveedor(ruc, razónSocial)
  else cliente
    Admin -> Cat: crearCliente(ruc, razónSocial)
  end
  Cat -> Cat: rucDisponible(ruc)
  break el RUC ya existe (4a)
    Cat --> Admin: pide otro RUC (vuelve al paso 2)
  end
  create Prov
  Cat -> Prov: «create»(ruc, razónSocial, tipo = subcontratista)
  note right of Prov
    Un cliente se crea igual, con su RUC y su razón social.
  end note
else modificar una empresa o un cliente (2a)
  Admin -> Prov: modificar(datos)
  Admin -> Cli: modificar(datos)
else dar de baja una empresa o un cliente (2b)
  Admin -> Prov: darDeBaja(actor)
  Admin -> Cli: darDeBaja(actor)
end
Cat --> Admin: registro guardado con actor y fecha
@enduml
