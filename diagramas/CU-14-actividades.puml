@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-14 · Actividades · Consultar tablero financiero
|Administrador|
start
:Ingresar al tablero y elegir una obra o todas;
|Motor de ingeniería|
if (¿Organización, obra y rol válidos? (NF-01)) then ([no])
  :No mostrar los datos de esa obra;
  stop
else ([sí])
endif
fork
  :Obtener presupuesto vigente, costos propios
  y subcontratados y lo certificado por rubro;
fork again
  |Sistema ERP|
  :Entregar lo facturado, cobrado, pagado y los saldos;
  if (¿El ERP responde?) then ([no])
    |Motor de ingeniería|
    :Marcar los financieros como no disponibles,
    con la fecha del último dato;
  else ([sí])
  endif
end fork
|Motor de ingeniería|
:Mostrar totales y diferencias con fecha,
unidad, moneda (PYG) y procedencia (NF-11);
|Administrador|
repeat
  :Filtrar por rubro o fecha, o elegir un total;
  |Motor de ingeniería|
  :Recalcular a esa fecha o abrir el respaldo
  del total (NF-12);
  |Administrador|
repeat while (¿Consulta otro total?) is ([sí]) not ([no])
if (¿Exporta la vista?) then ([sí])
  |Motor de ingeniería|
  :Generar archivo nuevo XLSX o PDF;
else ([no])
endif
stop
@enduml
