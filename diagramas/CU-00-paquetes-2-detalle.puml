@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title Ctrl+ – Subsistemas (detalle de clases)
hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60
skinparam class {
  BackgroundColor #F1F1F1
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}

package "Ctrl+" {

package "Motor de finanzas" {
  class "Cálculo del certificado" as CalculoCertificado <<control>> {
    +calcularVersión(versión :VersionCertificado, actor :Usuario) :void
    +confirmar(versión :VersionCertificado, actor :Usuario) :void
  }
  class "Certificado" as Certificado <<Entity>> {
    +generarVersiónSiguiente(actor :Usuario) :VersionCertificado
  }
  class "Versión del certificado" as VersionCertificado <<Entity>> {
    -número :entero {unique}
    -estado :EstadoVersionCertificado
    +tomarCantidades() :void
    +cerrarCantidades(actor :Usuario) :void
  }
  class "Retención" as Retencion <<Entity>> {
    -tipo :TipoRetención {required}
    -porcentaje :decimal {value >= 0}
  }
  class "Registro de liquidaciones" as RegistroLiquidacion <<control>> {
    +liquidar(versión :VersionCertificado, mediciones :Medicion[*]) :Liquidacion
    +buscar(versión :VersionCertificado) :Liquidacion [0..1]
  }
}

package "ECMS" {
  class "Medición" as Medicion <<Entity>> {
    -cantidad :decimal {required}
    -unidad :texto
    -estado :EstadoMedicion
    -fecha :fecha y hora {readonly}
    +confirmar(actor :Usuario) :void
    +anular(motivo :texto, actor :Usuario) :void
    +registrarAjuste(cantidad :decimal, motivo :texto) :MedicionAjuste
  }
  class "Presupuesto de costos" as PresupuestoCostos <<Entity>> {
    +obtenerVigente() :VersionPresupuestoCostos [0..1]
    +guardarVersión(cambios :texto, motivo :texto) :VersionPresupuestoCostos
  }
  class "Liquidación" as Liquidacion <<Entity>> {
    -número :entero {unique}
    -bruto :guaraníes
    -neto :guaraníes
    -/aPagar :guaraníes
    +calcular(alcance :texto, condiciones :texto) :void
    +aplicarDeducciones(condiciones :texto) :void
  }
  class "Detalle de la liquidación" as DetalleLiquidacion <<Entity>> {
    -cantidadCertificada :decimal
    -importe :guaraníes
    +calcularImporte() :guaraníes
  }
  class "BIM" as Modelo <<Entity>> {
    -nombre :texto {required}
    +agregarVersion(archivo :Archivo, origen :texto, actor :Usuario) :VersionModelo
    +fijarVersionVigente(versión :VersionModelo) :void
  }
  class "Versión de modelo" as VersionModelo <<Entity>> {
    -número :entero {unique}
    -hash :texto
    -estado :EstadoVersion
    +publicar(actor :Usuario) :void
    +archivar(actor :Usuario) :void
  }
  class "Incidencia" as Incidencia <<Entity>> {
    -número :entero {unique}
    -estado :EstadoIncidencia
    +marcarCambio(globalIds :texto[*], versión :VersionModelo) :void
  }
}

package "ERP" {
  class "Presupuesto del cliente" as PresupuestoCliente <<Entity>> {
    -estado :EstadoPresupuestoCliente
    +cargarArchivo(archivo :Archivo) :void
    +confirmarEstructura() :void
  }
  class "Documentos" as Documento <<Entity>> {
    -nombre :texto {required}
    -estado :EstadoDocumento
    +abrirParaEditar(actor :Usuario) :Archivo
    +agregarVersión(archivo :Archivo, actor :Usuario) :VersionDocumento
  }
  class "Versión del documento" as VersionDocumento <<Entity>> {
    -número :entero {unique}
    -fecha :fecha y hora {readonly}
  }
  class "Usuario" as Usuario <<Entity>> {
    -nombre :texto {required}
    -correo :texto {unique}
    +perteneceA(organización :Organización) :lógico
  }
}

}

CalculoCertificado "1" -- "*" Certificado : calcula
CalculoCertificado "1" -- "*" Retencion : aplica
Certificado "1" *-- "1..*" VersionCertificado
Certificado "1" -- "*" RegistroLiquidacion : se liquida en
RegistroLiquidacion "1" -- "*" Liquidacion : registra
CalculoCertificado "*" -- "*" Medicion : lee
Liquidacion "1" *-- "*" DetalleLiquidacion
Medicion "*" -- "1" PresupuestoCostos : mide
Incidencia "*" -- "1" Modelo : sobre
Modelo "1" *-- "1..*" VersionModelo
PresupuestoCostos "*" -- "1" PresupuestoCliente : parte de
Modelo "*" -- "1" Documento : parte de
Usuario "1" -- "*" Documento : sube
Documento "1" *-- "1..*" VersionDocumento

@enduml
