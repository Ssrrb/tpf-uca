@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-06 · 1/2 · Valorizar y calcular la versión
actor "Ingeniero de obra" as Ing
box "Motor de finanzas" #EAF2F6
participant "calculo:\nCalculoCertificado" as Calc
end box
box "ECMS" #EAF2F6
participant "version:\nVersionCertificado" as V
participant "linea:\nLineaCertificado" as Lin
participant "cliente:\nPresupuestoCliente" as Cli
participant "adendas:\nPresupuestoAdendas" as Ade
end box
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
participant "anticipo:\nAnticipo" as Ant
end box

Ing -> Calc: calcularVersión(version, actor)
Calc -> Obra: permiteCertificar()
Obra --> Calc: permitido: lógico
break la obra no está en ejecución (RF-33)
  Calc --> Ing: no se calculan versiones
end
Calc -> V: estaCerrada()
V --> Calc: cerrada: lógico
break las cantidades no se cerraron en CU-04
  Calc --> Ing: primero hay que cerrar las cantidades
end
opt error en una versión ya guardada (1a, RF-12)
  Ing -> V: agregarLíneaAjuste(versiónCorregida, cantidad, importe, motivo)
end

loop por cada línea de la versión
  Calc -> Cli: precioUnitario(ítem)
  Cli --> Calc: precio [0..1]
  opt ítem de adenda o sin precio en el presupuesto del cliente
    Calc -> Ade: precioVigente(ítem, fecha)
    Ade --> Calc: precio [0..1]
  end
  break sin precio unitario en ninguno de los dos (2a)
    Calc --> Ing: lo señala e impide confirmar
  end
  Calc -> Lin: valorizar(precio)
  Lin --> Calc: importe redondeado a guaraníes (NF-06)
end
Calc -> Ant: amortizar(bruto)
Ant --> Calc: amortización hasta cancelar el anticipo
note right of Calc
  bruto - amortización - fondo de reparo = neto;
  IVA sobre el neto (RF-13).
end note
Calc -> V: registrarImportes(bruto, amortización, fondoReparo, neto, iva)
ref over Ing, Ant
  Continúa en 2/2: consumo de recursos y guardado.
end ref
@enduml
