@startuml
!theme plain
skinparam style strictuml
title CU-09 · Liquidar subcontratista
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  enum EstadoVersionCertificado <<enumeration>> {
    abierta
    cantidades_cerradas
    guardada
  }

  class "Versión del certificado" as VersionCertificado {
    número: entero
    estado: EstadoVersionCertificado
    --
    + medicionesSinLiquidar(contrato): lista de Medicion
    + controlarLímites(alcance, mediciones): lista de texto
    + liquidarSubcontratista(contrato, actor): Liquidacion
  }

  class "Medición" as Medicion {
    cantidad: decimal
    liquidada: lógico
    --
    + estaLiquidada(): lógico
    + marcarLiquidada(liquidación): vacío
  }
}

package "ERP" {
  class Contrato {
    número: texto
    porcentajeFondoReparo: decimal
    impuestos: decimal
    --
    + alcance(): lista de ItemContrato
    + condiciones(): lista de Retencion
  }

  class "Ítem del contrato" as ItemContrato {
    cantidad: decimal
    precio: guaraníes
    límite: decimal
    --
    + datos(): ItemContrato
  }

  class "Retención" as Retencion {
    tipo: IVA | renta
    porcentaje: decimal
    --
    + datos(): Retencion
  }
}

package "Motor de finanzas" {
  class "Registro de liquidaciones" as RegistroLiquidacion {
    --
    + liquidar(versión, contrato, mediciones, alcance, condiciones): Liquidacion
    + buscar(versión, contrato): Liquidacion [0..1]
  }

  class "Liquidación" as Liquidacion {
    número: entero
    bruto: guaraníes
    fondoReparo: guaraníes
    neto: guaraníes
    iva: guaraníes
    retenciones: guaraníes
    /aPagar: guaraníes
    registradaPor: Usuario
    fecha: fecha y hora
    --
    + calcular(alcance, condiciones): vacío
    + armarDetalle(mediciones, alcance): vacío
    + aplicarDeducciones(condiciones): vacío
  }

  class "Detalle de la liquidación" as DetalleLiquidacion {
    cantidadCertificada: decimal
    precioContrato: guaraníes
    importe: guaraníes
    --
    + calcularImporte(): guaraníes
  }

  class "Deducción" as Deduccion {
    tipo: TipoDeduccion
    importe: guaraníes
    --
    + calcularImporte(base): guaraníes
  }

  enum TipoDeduccion <<enumeration>> {
    fondo_de_reparo
    retencion_de_IVA
    retencion_de_renta
    IVA
  }
}

VersionCertificado "1" --> "0..*" Medicion : certifica
Medicion "0..*" --> "0..1" Contrato : a nombre de
Liquidacion "0..1" --> "1..*" Medicion : liquida
Contrato "1" *-- "1..*" ItemContrato : alcance
Contrato "0..*" --> "0..*" Retencion : aplica
RegistroLiquidacion ..> Liquidacion : registra
Liquidacion "1" *-- "1..*" DetalleLiquidacion : detalle
Liquidacion "1" *-- "0..*" Deduccion : deducciones
DetalleLiquidacion "0..*" --> "1" ItemContrato : ítem
Deduccion ..> TipoDeduccion : tipo
VersionCertificado ..> EstadoVersionCertificado : estado
Liquidacion "0..*" --> "1" Contrato : de
Liquidacion "0..*" --> "1" VersionCertificado : por

note bottom of Liquidacion
  Única por (versión, contrato). Se registra una vez y no cambia:
  no tiene estados. El pago ocurre fuera del sistema y no se
  registra en el MVP.
end note

@enduml
