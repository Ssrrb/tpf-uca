@startuml
!theme plain
skinparam style strictuml
title CU-09 · Liquidar subcontratista
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Versión del certificado" as VersionCertificado {
    número: entero
    estado: guardada
    --
    + medicionesSinLiquidar(contrato): lista de Medición
    + controlarLímites(alcance, mediciones): lista de texto
    + liquidarSubcontratista(contrato, actor): Liquidación
  }

  class "Medición" as Medicion {
    cantidad: decimal
    liquidada: lógico
    --
    + estaLiquidada(): lógico
    + marcarLiquidada(liquidación): vacío
  }
}

package "ERP" {
  class Contrato {
    número: texto
    porcentajeFondoReparo: decimal
    impuestos: decimal
    --
    + alcance(): lista de ÍtemContrato
    + condiciones(): lista de Retención
  }

  class "Ítem del contrato" as ItemContrato {
    cantidad: decimal
    precio: guaraníes
    límite: decimal
    --
    + datos(): cantidad, precio y límite
  }

  class "Retención" as Retencion {
    tipo: IVA | renta
    porcentaje: decimal
    --
    + datos(): tipo y porcentaje
  }
}

package "Motor de finanzas" {
  class "Liquidaciones" as Liquidaciones {
    --
    + liquidar(versión, contrato, mediciones, alcance, condiciones): Liquidación
    + buscar(versión, contrato): Liquidación [0..1]
  }

  class "Liquidación" as Liquidacion {
    número: entero
    bruto: guaraníes
    fondoReparo: guaraníes
    neto: guaraníes
    iva: guaraníes
    retenciones: guaraníes
    /aPagar: guaraníes
    registradaPor: Usuario
    fecha: fecha y hora
    --
    + calcular(alcance, condiciones): vacío
  }
}

VersionCertificado "1" --> "0..*" Medicion : certifica
Medicion "0..*" --> "0..1" Contrato : a nombre de
Liquidacion "0..1" --> "1..*" Medicion : liquida
Contrato "1" *-- "1..*" ItemContrato : alcance
Contrato "0..*" --> "0..*" Retencion : aplica
Liquidaciones ..> Liquidacion : registra
Liquidacion "0..*" --> "1" Contrato : de
Liquidacion "0..*" --> "1" VersionCertificado : por

note bottom of Liquidacion
  Única por (versión, contrato). Se registra una vez y no cambia:
  no tiene estados. El pago ocurre fuera del sistema y no se
  registra en el MVP.
end note

@enduml
