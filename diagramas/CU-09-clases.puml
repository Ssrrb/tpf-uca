@startuml
!theme plain
skinparam style strictuml
title CU-09 · Registrar contrato de subcontratista
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ERP" {
  class Obra {
    código: texto
    --
    + númeroContratoDisponible(número): lógico
    + registrarContrato(subcontratista, número, fechas, archivo): Contrato
  }

  class Proveedor {
    ruc: texto
    esSubcontratista: lógico
    --
    + esSubcontratista(): lógico
  }

  class Contrato {
    número: texto
    fechaInicio: fecha
    fechaFin: fecha
    archivo: archivo
    impuestos: decimal
    porcentajeFondoReparo: decimal
    registradoPor: Usuario
    fecha: fecha y hora
    --
    + validarArchivo(): lógico
    + agregarÍtem(ítem, precio, límite): vacío
    + configurarCondiciones(impuestos, retenciones, fondoReparo): vacío
    + confirmar(actor): vacío
  }

  class "Ítem del contrato" as ItemContrato {
    precio: guaraníes
    límite: decimal
  }

  class "Retención" as Retencion {
    tipo: IVA | renta
    porcentaje: decimal
  }
}

package "ECMS" {
  class "Saldo del ítem" as SaldoItem {
    cantidadPresupuestada: decimal
    asignadaAContratos: decimal
    --
    + cantidadPresupuestada(): decimal
    + disponibleParaContratos(): decimal
    + reservarParaContrato(cantidad): vacío
  }

  class "Ítem de costos" as ItemCostos {
    código: texto {estable}
  }
}

Obra "1" *-- "0..*" Contrato : subcontratos
Contrato "0..*" --> "1" Proveedor : con
Contrato "1" *-- "1..*" ItemContrato : alcance
ItemContrato "0..*" --> "1" ItemCostos : ítem
ItemCostos "1" *-- "1" SaldoItem : saldo
Contrato "0..*" --> "0..*" Retencion : aplica

note bottom of SaldoItem
  El ECMS lleva el saldo de cada ítem y el ERP lo consulta:
  ninguna cantidad se asigna a dos contratos (RF-08).
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
