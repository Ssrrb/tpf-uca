@startuml
!theme plain
skinparam style strictuml
title CU-11 · Registrar adenda
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Presupuesto de costos" as PresupuestoCostos {
    --
    + ítemsEnExceso(): lista de SaldoItem
  }

  class "Apartado Adendas" as ApartadoAdendas {
    /utilizado: guaraníes
    --
    + crearAdenda(tipo, motivo, respaldo): Adenda
    + utilizado(): guaraníes
    + registrar(adenda, actor): vacío
  }

  class Adenda {
    número: entero
    tipo: texto {de obra | de plazo}
    nuevaFechaFin: fecha [0..1]
    motivo: texto
    respaldo: archivo
    registradaPor: Usuario
    fecha: fecha y hora
    /precioVenta: guaraníes
    /costo: guaraníes
    --
    + agregarÍtem(línea, cantidadAprobada, costo): vacío
    + fijarNuevaFechaFin(fecha): vacío
    + calcularImportes(): vacío
    + validarDatos(): lista de texto
  }

  class "Ítem de adenda" as ItemAdenda {
    cantidadAprobada: decimal
    precioVenta: guaraníes
    costo: guaraníes
  }

  class "Presupuesto de adendas del cliente" as PresupuestoAdendas {
    número: entero
    --
    + líneasPendientes(): lista de LineaPresupuestoAdendas
  }

  class "Línea del presupuesto de adendas" as LineaPresupuestoAdendas {
    cantidad: decimal
    precioVenta: guaraníes
    /cantidadAprobada: decimal
    --
    + cantidadPendiente(): decimal
    + descontarAprobada(cantidad): vacío
  }

  class "Ítem de costos" as ItemCostos {
    código: texto {estable}
    unidad: texto
  }

  class "Saldo del ítem" as SaldoItem {
    cantidadAdendas: decimal
    exceso: guaraníes
    /saldoContractual: decimal
    --
    + sumarAdenda(cantidad): vacío
  }
}

package "ERP" {
  class Obra {
    límiteAdendas: decimal
    fechaFinVigente: fecha
    --
    + permiteAdendas(): lógico
    + obtenerLímiteAdendas(): guaraníes
    + actualizarFechaFin(fecha, motivo): vacío
  }
}

PresupuestoCostos "1" *-- "1" ApartadoAdendas : se suma a la vigente
ApartadoAdendas "1" *-- "0..*" Adenda : adendas registradas
Adenda "1" *-- "0..*" ItemAdenda : ítems aprobados
ItemAdenda "0..*" --> "1" LineaPresupuestoAdendas : aprueba
ItemAdenda "0..*" --> "1" ItemCostos : amplía o crea
PresupuestoAdendas "1" *-- "1..*" LineaPresupuestoAdendas : líneas
ItemCostos "1" *-- "1" SaldoItem : saldo
ApartadoAdendas "0..*" --> "1" Obra : de la obra

@enduml
