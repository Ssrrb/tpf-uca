@startuml
!theme plain
skinparam style strictuml
title CU-11 · Registrar adenda
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Presupuesto de costos" as PresupuestoCostos {
    --
    + ítemsConSaldoNegativo(): lista de SaldoÍtem
  }

  class "Apartado Adendas" as ApartadoAdendas {
    /utilizado: guaraníes
    --
    + crearAdenda(ítem, tipo, cantidad, precioVenta, costo): Adenda
    + crearÍtemNuevo(rubro, descripción, unidad): ÍtemCostos
    + utilizado(): guaraníes
    + registrar(adenda, actor): vacío
  }

  class Adenda {
    tipo: TipoAdenda
    cantidad: decimal [0..1]
    precioVenta: guaraníes [0..1]
    costo: guaraníes [0..1]
    nuevaFechaFin: fecha [0..1]
    motivo: texto
    respaldo: archivo
    registradaPor: Usuario
    fecha: fecha y hora
    --
    + adjuntarRespaldo(motivo, archivo): vacío
    + calcularImportes(): vacío
    + validarDatos(): lista de texto
  }

  class "Presupuesto de adendas" as PresupuestoAdendas {
    --
    + registrarPrecio(adenda): vacío
  }

  class "Ítem de costos" as ItemCostos {
    código: texto {estable}
    unidad: texto
  }

  class "Saldo del ítem" as SaldoItem {
    cantidadAdendas: decimal
    retenida: decimal
    /saldoContractual: decimal
    --
    + cantidadRetenida(): decimal
    + sumarAdenda(cantidad): vacío
    + liberarRetenida(cantidad): vacío
  }

  enum TipoAdenda {
    ampliación
    deducción
    variación_de_precio
    ítem_nuevo
    ampliación_de_plazo
  }
}

package "ERP" {
  class Obra {
    límiteAdendas: guaraníes
    fechaFinVigente: fecha
    --
    + permiteAdendas(): lógico
    + obtenerLímiteAdendas(): guaraníes
    + actualizarFechaFin(fecha, motivo): vacío
  }
}

PresupuestoCostos "1" *-- "1" ApartadoAdendas : se suma a la vigente
ApartadoAdendas "1" *-- "0..*" Adenda : costo de las adendas
Adenda "0..*" --> "0..1" ItemCostos : modifica o crea
ItemCostos "1" *-- "1" SaldoItem : saldo
PresupuestoAdendas "0..*" --> "0..*" Adenda : precio de venta
ApartadoAdendas "0..*" --> "1" Obra : de la obra

note bottom of Adenda
  No modifica la versión vigente del presupuesto
  de costos (RN-03). Suma al saldo contractual
  del ítem (RN-04). Sin adenda, el rubro queda
  en negativo como mayor costo.
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
