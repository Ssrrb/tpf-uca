@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-04 · Medir el avance del certificado
actor "Ingeniero de obra" as Ing
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
participant "contrato:\nContrato" as Con
end box
box "ECMS" #EAF2F6
participant "item:\nItemCostos" as Item
participant "saldo:\nSaldoItem" as Saldo
participant "medicion:\nMedicion" as Med
participant "evidencia:\nEvidencia" as Evi
participant "certificado:\nCertificado" as Cert
participant "version:\nVersionCertificado" as V
participant "linea:\nLineaCertificado" as Lin
participant "ajuste:\nMedicionAjuste" as Aj
end box

Ing -> Obra: permiteMediciones()
Obra --> Ing: permitido: lógico
break la obra no está en ejecución (RF-23)
  Obra --> Ing: no se registran mediciones
end
Ing -> Item: obtenerSaldo()
Item -> Saldo: saldoContractual()
Saldo --> Item: saldo
Item --> Ing: ítems con su saldo contractual

loop por cada ítem medido
  create Med
  Ing -> Med: «create»(ítem, cantidad, unidad, ejecutor)
  Med -> Item: insumosDelACU(cantidad)
  Item --> Med: insumos propuestos (RF-07)
  opt el Ingeniero corrige un insumo
    Ing -> Med: corregirInsumo(insumo, cantidad)
  end
  Ing -> Med: adjuntarEvidencia(archivo)
  create Evi
  Med -> Evi: «create»(tipo, archivo)
  Med -> Saldo: estaContada(cantidad, medicion)
  Saldo --> Med: contada: lógico
  break ya está contada en otra medición (4a, RF-08)
    Med --> Ing: rechazada; indica dónde figura
  end
  Ing -> Med: confirmar(actor)
  Med -> Med: validarCompleta()
  break faltan datos obligatorios o evidencia (5a)
    Med --> Ing: marca cada campo e impide confirmar
  end
  Med -> Saldo: registrarMedición(cantidad)
  opt ítem subcontratado (3a)
    Med -> Con: descontarSaldo(ítem, cantidad)
  end
end

Ing -> Cert: generarVersiónSiguiente(actor)
create V
Cert -> V: «create»(número siguiente, anterior)
V -> V: tomarCantidades()
loop por cada ítem con mediciones o ajustes sin certificar
  V -> Saldo: cantidadCertificable()
  Saldo --> V: cantidad medida sin certificar
  create Lin
  V -> Lin: «create»(ítem, avance anterior, cantidad)
  V -> Med: incluirEn(version)
end
Ing -> V: cerrarCantidades(actor)
V --> Ing: versión con avance anterior, de la versión\ny acumulado, lista para el cálculo (CU-06)

== *a Anular o ajustar una medición ==
Ing -> Med: puedeAnularse()
Med --> Ing: registrada: lógico
alt registrada (todavía no está en una versión)
  Ing -> Med: anular(motivo, actor)
  Med -> Saldo: revertirMedición(cantidad)
else incluida en una versión o certificada (RF-07)
  Ing -> Med: registrarAjuste(cantidad, motivo, actor)
  create Aj
  Med -> Aj: «create»(original, cantidad, motivo)
  note right of Aj
    Entra en la versión siguiente.
  end note
end
@enduml
