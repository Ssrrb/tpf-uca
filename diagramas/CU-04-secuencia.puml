@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-04 · Gestionar la medición de avance e insumos
actor "Ingeniero de obra" as Ing
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
participant "contrato:\nContrato" as Con
end box
box "ECMS" #EAF2F6
participant "item:\nItemCostos" as Item
participant "saldo:\nSaldoItem" as Saldo
participant "medicion:\nMedicion" as Med
participant "consumo:\nConsumoInsumo" as Cons
participant "evidencia:\nEvidencia" as Evi
participant "ajuste:\nMedicionAjuste" as Aj
end box

Ing -> Obra: permiteMediciones()
Obra --> Ing: permitido: lógico
break la obra no está en ejecución (RF-33)
  Obra --> Ing: no se registran mediciones
end
Ing -> Item: obtenerSaldo()
Item --> Ing: cantidad contractual, medida y saldo (RN-04)

create Med
Ing -> Med: «create»(ítem, cantidad, unidad, ejecutor)
opt ejecuta un subcontratista (3a)
  Med -> Con: saldoDisponible(ítem)
  Con --> Med: saldo del contrato
end
loop por cada insumo consumido
  Ing -> Med: agregarInsumo(insumo, cantidad)
  create Cons
  Med -> Cons: «create»(insumo, cantidad)
end
Ing -> Med: adjuntarEvidencia(archivo)
create Evi
Med -> Evi: «create»(tipo, archivo)

Med -> Saldo: estaContada(cantidad, medicion)
Saldo --> Med: contada: lógico
break ya está contada en otra medición (7b, RF-10)
  Med --> Ing: rechazada; indica dónde figura (vuelve al paso 3)
end
Med -> Saldo: saldoContractual()
Saldo --> Med: saldo
opt la cantidad supera el saldo (7a, RF-09)
  Med --> Ing: exceso como saldo negativo del rubro;\nqueda fuera del certificado hasta una adenda (CU-11)
end

Ing -> Med: confirmar(actor)
Med -> Med: validarCompleta()
break faltan datos obligatorios o evidencia (8a)
  Med --> Ing: marca cada campo e impide confirmar
end
Med -> Saldo: registrarMedición(cantidad)
opt ejecutor subcontratado
  Med -> Con: descontarSaldo(ítem, cantidad)
end
Med --> Ing: medición registrada con actor, fecha, obra,\ninsumos y evidencia (RF-07)

== *a Anular, enmendar o ajustar una medición registrada ==
Ing -> Med: estaCertificada()
Med --> Ing: certificada: lógico
alt no certificada: anular
  Ing -> Med: anular(motivo, actor)
  Med -> Saldo: revertirMedición(cantidad)
else no certificada: enmendar
  Ing -> Med: enmendar(datos, motivo, actor)
else certificada (RN-07)
  Ing -> Med: registrarAjuste(cantidad, motivo, actor)
  create Aj
  Med -> Aj: «create»(original, cantidad, motivo)
  note right of Aj
    Entra en la versión siguiente
    del certificado (CU-06).
  end note
end
@enduml
