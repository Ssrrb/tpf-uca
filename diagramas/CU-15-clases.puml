@startuml
!theme plain
skinparam style strictuml
title CU-15 · Cargar presupuesto de adendas del cliente
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Presupuesto de adendas del cliente" as PresupuestoAdendas {
    número: entero
    fecha: fecha
    estado: EstadoPresupuestoAdendas
    archivo: archivo [0..1]
    cargadoPor: Usuario
    /total: guaraníes
    --
    + importar(archivo): vacío
    + agregarLínea(ítem, descripción, unidad, cantidad, precioVenta): vacío
    + validar(): lista de texto
    + guardar(actor): vacío
    + cancelar(): vacío
  }

  class "Línea del presupuesto de adendas" as LineaPresupuestoAdendas {
    rubro: texto [0..1]
    descripción: texto
    unidad: texto
    cantidad: decimal
    precioVenta: guaraníes
    /importe: guaraníes
    --
    + esÍtemNuevo(): lógico
  }

  class "Ítem de costos" as ItemCostos {
    código: texto {estable}
    --
    + buscar(código): ItemCostos [0..1]
  }

  enum EstadoPresupuestoAdendas <<enumeration>> {
    en carga
    cargado
    descartado
  }
}

package "ERP" {
  class Obra {
    --
    + presupuestosDeAdendas(): lista de PresupuestoAdendas
    + siguienteNúmeroAdendas(): entero
  }
}

Obra "1" *-- "0..*" PresupuestoAdendas : presupuestos de adendas
PresupuestoAdendas "1" *-- "1..*" LineaPresupuestoAdendas : líneas
LineaPresupuestoAdendas "0..*" --> "0..1" ItemCostos : ítem existente
PresupuestoAdendas ..> EstadoPresupuestoAdendas : estado

@enduml
