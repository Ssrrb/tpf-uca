@startuml
!theme plain
skinparam style strictuml
title CU-15 · Emitir presupuesto de adendas
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Presupuesto de adendas" as PresupuestoAdendas {
    --
    + versiones(): lista de VersiónAdendas
    + hayCambios(): lógico
    + emitirVersión(actor): VersiónAdendas
    + activar(versión): vacío
  }

  class "Versión del presupuesto de adendas" as VersionAdendas {
    número: entero
    estado: en_edición | vigente | anterior | descartada
    motivo: texto [0..1]
    emitidaPor: Usuario
    fecha: fecha y hora
    /total: guaraníes
    --
    + armar(adendas): vacío
    + corregirLínea(línea, descripción, motivo): vacío
    + validarMotivos(): lista de texto
    + guardar(actor): vacío
    + pasarAAnterior(): vacío
    + cancelar(): vacío
    + exportar(formato: XLSX | PDF): archivo
  }

  class "Línea de adenda" as LineaAdenda {
    descripción: texto
    precioVenta: guaraníes
    motivoCorrección: texto [0..1]
    --
    + corregir(descripción, motivo): vacío
  }

  class "Apartado Adendas" as ApartadoAdendas {
    --
    + adendasRegistradas(): lista de Adenda
  }

  class Adenda {
    precioVenta: guaraníes
  }
}

PresupuestoAdendas "1" *-- "0..*" VersionAdendas : versiones
VersionAdendas "0..1" --> "0..1" VersionAdendas : anterior
VersionAdendas "1" *-- "1..*" LineaAdenda : líneas
LineaAdenda "0..*" --> "1" Adenda : de
ApartadoAdendas "1" *-- "0..*" Adenda : registradas (CU-11)
PresupuestoAdendas ..> ApartadoAdendas : toma las adendas

note bottom of VersionAdendas
  Documento contractual con el cliente. A diferencia del
  presupuesto del cliente se puede editar: cada edición
  crea una versión y conserva la anterior (RF-06, NF-04).
  El precio de venta se acuerda al registrar la adenda (CU-11);
  acá solo se corrige la descripción.
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
