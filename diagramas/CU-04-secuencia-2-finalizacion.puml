@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-04 · 2/2 · Totales y finalización
actor "Ingeniero de obra" as Ing
box "ECMS" #EAF2F6
participant "presupuesto:\nPresupuestoCliente" as Pres
participant "rubro:\nRubro" as Rubro
participant "item:\nItemCliente" as Item
participant "informe:\nInformeImportacion" as Inf
end box
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
end box

Pres -> Pres: recalcularTotales()
loop por cada rubro
  Pres -> Rubro: recalcularTotal()
  loop por cada ítem
    Rubro -> Item: recalcularTotal()
    Item --> Rubro: total (guaraníes enteros, NF-05)
  end
  Rubro --> Pres: total del rubro
end
Pres -> Pres: compararTotales()
loop por cada total declarado distinto del recalculado
  Pres -> Inf: registrarDiferencia(rubro, declarado, recalculado)
end
Pres --> Ing: diferencias de totales,\nsin alterar el archivo original (RF-04)
opt hay diferencias de totales (3a)
  alt acepta las diferencias informadas
    Ing -> Inf: aceptarDiferencias()
  else corrige el archivo
    ref over Ing, Obra
      Recarga el XLSX en CU-03.
    end ref
  end
end
alt finaliza el presupuesto (paso 4)
  Ing -> Pres: finalizar(actor)
  critical finalización atómica (NF-02)
    Pres -> Obra: vincularPresupuestoCliente(presupuesto)
    break falla la finalización (5a)
      Pres --> Ing: sigue en propuesta; se puede reintentar
    end
  end
  Pres --> Ing: presupuesto contractual que ya no se modifica,\ncon actor y fecha; base de la estructura de trabajo (CU-05)
else no lo finaliza todavía (4a)
  Pres --> Ing: queda en propuesta
end
@enduml
