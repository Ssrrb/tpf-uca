@startuml
!theme plain
skinparam style strictuml
title CU-14 · Registrar cobros y pagos
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "Motor de finanzas" {
  class "Documento pendiente" as DocumentoPendiente {
    tipo: texto {factura interna | liquidación | fondo de reparo}
    contraparte: texto {cliente | subcontratista}
    número: entero
    total: guaraníes
    saldoPendiente: guaraníes
    --
    + mostrarConOrigen(): VersiónCertificado
    + validarImporte(importe, retenciones): lógico
    + actualizarSaldo(movimiento): vacío
  }


  class Movimiento {
    tipo: texto {cobro | pago}
    importe: guaraníes
    fecha: fecha
    medio: texto
    registradoPor: Usuario
    --
    + adjuntarComprobante(archivo): vacío
    + agregarRetención(tipo, importe, comprobante): vacío
    + confirmar(actor): vacío
  }


  class "Retención del movimiento" as RetencionMovimiento {
    tipo: IVA | renta
    importe: guaraníes
  }

  class Comprobante {
    tipo: factura | planilla | ticket | recibo | comprobante | retención
    archivo: archivo
  }
}

package "ERP" {
  class Obra {
    estado: EstadoObra
    --
    + permiteCobrosYPagos(): lógico
    + estaEnRecepciónDefinitiva(): lógico
  }
}

DocumentoPendiente "1" *-- "0..*" Movimiento : cancela
Movimiento "1" *-- "0..*" RetencionMovimiento : retenciones
Movimiento "1" *-- "1..*" Comprobante : adjuntos
DocumentoPendiente "0..*" --> "1" Obra : de la obra

@enduml
