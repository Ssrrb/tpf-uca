@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-12 · Liquidar subcontratista
actor "Ingeniero de obra" as Ing
box "ECMS" #EAF2F6
participant "version:\nVersionCertificado" as V
participant "linea:\nLineaCertificado" as Lin
end box
box "ERP" #EAF2F6
participant "contrato:\nContrato" as Con
participant "retencion:\nRetencion" as Ret
end box
box "Motor de finanzas" #EAF2F6
participant "liquidaciones:\nLiquidaciones" as Mot
participant "liquidacion:\nLiquidacion" as Liq
end box

Ing -> V: líneasSubcontratadasPorContrato()
V --> Ing: ítems subcontratados sin liquidar, agrupados por contrato
loop por cada contrato de la versión (3a)
  loop por cada línea del contrato
    Ing -> Con: valorizar(ítem, cantidad)
    Con --> Ing: importe al precio del contrato (RF-25)
    V -> Lin: estaLiquidada()
    Lin --> V: liquidada: lógico
    opt ya se liquidó en otra versión (4a, RF-10)
      V --> Ing: la excluye e informa en cuál
    end
  end
  V -> Con: excedeLímite(importe)
  Con --> V: excede: lógico
  break supera el límite del contrato (4b)
    V --> Ing: impide enviar ese contrato (vuelve al paso 3)
  end
  alt confirma el envío (paso 5)
    Ing -> V: enviarALiquidar(contrato, actor)
    V -> Mot: liquidar(version, contrato, cantidades)
    Mot -> Mot: buscar(version, contrato)
    alt ya existe (reintento, NF-03)
      Mot --> V: número de la liquidación existente
    else no existe
      create Liq
      Mot -> Liq: «create»(version, contrato, cantidades)
      Mot -> Liq: calcular(contrato)
      Liq -> Con: valorizar(ítem, cantidad)
      loop por cada retención del contrato
        Liq -> Ret: aplicar(base)
        Ret --> Liq: importe retenido
      end
      note right of Liq
        Aplica fondo de reparo, deducciones e
        impuestos del contrato; queda pendiente de pago.
      end note
      Mot --> V: número de la liquidación
    end
    break falla el registro en el Motor de finanzas (7a)
      V --> Ing: no se marca ninguna cantidad; el CU termina
    end
    loop por cada línea enviada
      V -> Lin: marcarLiquidada(liquidacion)
    end
    V --> Ing: liquidación pendiente de pago (CU-14)
  else no confirma (5a)
    V --> Ing: no se envía nada; las cantidades quedan sin liquidar
  end
end
@enduml
