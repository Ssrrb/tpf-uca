@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-08 · Calcular el certificado
actor "Ingeniero de obra" as Ing
box "Motor de finanzas" #EAF2F6
participant "calculo:\nCalculoCertificado" as Calc
end box
box "ECMS" #EAF2F6
participant "version:\nVersionCertificado" as V
participant "linea:\nLineaCertificado" as Lin
participant "saldo:\nSaldoItem" as Saldo
participant "cliente:\nPresupuestoCliente" as Cli
participant "medicion:\nMedicion" as Med
end box
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
participant "anticipo:\nAnticipo" as Ant
end box

Ing -> Calc: calcularVersión(version, actor)
Calc -> Obra: permiteCertificar()
Obra --> Calc: permitido: lógico
break la obra no está en ejecución (RF-23)
  Calc --> Ing: no se calculan versiones
end
Calc -> V: estaCerrada()
V --> Calc: cerrada: lógico
break las cantidades no se cerraron en CU-07 · Medir el avance del certificado
  Calc --> Ing: primero hay que cerrar las cantidades
end
opt error en una versión ya guardada (1a, RF-09)
  Ing -> V: agregarLíneaAjuste(versiónCorregida, cantidad, importe, motivo)
end

loop por cada línea de la versión
  Calc -> Cli: precioUnitario(ítem)
  Cli --> Calc: precio [0..1]
  break sin precio unitario (2a)
    Calc --> Ing: lo señala e impide confirmar
  end
  Calc -> Lin: valorizar(precio)
  Lin --> Calc: importe redondeado a guaraníes (NF-05)
  Calc -> Saldo: montoContractual()
  Saldo --> Calc: monto contractual (presupuesto del cliente)
  Calc -> Lin: señalarExceso(montoContractual)
  Lin --> Calc: exceso [0..1]
  opt el monto acumulado supera el monto contractual (3a)
    Calc -> Saldo: registrarExceso(exceso)
    Calc --> Ing: ítem en exceso: saldo negativo del ítem y del rubro,\nfuera del bruto
  end
end
Calc -> Ant: amortizar(bruto)
Ant --> Calc: amortización hasta cancelar el anticipo
note right of Calc
  bruto (sin el exceso) - amortización - fondo
  de reparo = neto; IVA sobre el neto (RF-10).
end note
Calc -> V: registrarImportes(bruto, amortización, fondoReparo, neto, iva)
Calc --> Ing: versión valorizada para revisar

Ing -> Calc: confirmar(version, actor)
critical guardado en una sola operación (NF-02)
  Calc -> V: guardar(actor)
  loop por cada medición de la versión
    Calc -> Med: marcarCertificada(version)
    Calc -> Saldo: registrarCertificado(cantidad)
  end
  break falla el guardado (6b)
    Calc --> Ing: no se guarda la versión ni se certifican sus mediciones; se puede reintentar
  end
end
Calc --> Ing: versión guardada; disponible para liquidar en CU-09 · Liquidar subcontratista
@enduml
