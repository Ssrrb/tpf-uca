@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-08 · Generar factura interna del certificado
actor "Finanzas y tesorería" as Fin
box "Motor de finanzas" #EAF2F6
participant "facturacion:\nFacturacion" as Fac
participant "factura:\nDocumentoInterno" as Doc
participant "legal:\nFacturaLegal" as Leg
participant "cuenta:\nCuentaACobrar" as CxC
end box
box "ECMS" #EAF2F6
participant "version:\nVersionCertificado" as V
end box
box "ERP" #EAF2F6
participant "obra:\nObra" as Obra
participant "anticipo:\nAnticipo" as Ant
end box

Fin -> Fac: listarPendientes(obra)
loop por cada versión guardada
  Fac -> V: importeSinFacturar()
  V --> Fac: importe
end
Fac --> Fin: versiones con importe sin facturar y anticipo sin facturar

alt elige una versión del certificado (paso 3)
  Fin -> Fac: generarFactura(version, actor)
  Fac -> Obra: datosCliente()
  Obra --> Fac: cliente [0..1]
  break faltan datos del cliente (4a)
    Fac --> Fin: informa el dato faltante; no genera la factura
  end
  alt neto positivo
    create Doc
    Fac -> Doc: «create» FacturaInterna(neto, iva de la versión)
  else neto negativo por ajustes (3a)
    Fac -> Doc: «create» NotaCreditoInterna(neto, iva de la versión)
  end
else elige el anticipo (3b, RF-22)
  Fin -> Fac: generarFacturaAnticipo(anticipo, actor)
  Fac -> Doc: «create» FacturaInterna(importe del anticipo)
  Fac -> Ant: marcarFacturado()
end
Fac --> Fin: documento en PYG, sin validez fiscal (RF-11)

alt adjunta la factura legal (paso 6)
  Fin -> Doc: adjuntarFacturaLegal(número, fecha, importe, archivo)
  create Leg
  Doc -> Leg: «create»(número, fecha, importe, archivo)
  Doc -> Doc: compararConLegal()
  opt el importe legal difiere del interno (6b)
    Doc --> Fin: señala la diferencia
    Fin -> Doc: registrarMotivoDiferencia(motivo)
  end
else la legal todavía no se emitió (6a)
  note over Fin, Doc
    Confirma sin adjunto: queda pendiente de adjuntar.
  end note
end
Fin -> Doc: confirmar(actor)
create CxC
Doc -> CxC: «create»(saldoPendiente = total)
Doc --> Fin: cuenta a cobrar de la obra vinculada a la versión
@enduml
