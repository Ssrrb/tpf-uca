@startuml
!theme plain
skinparam style strictuml
title Diagrama de Casos de Uso (Alto Nivel)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #167C80
skinparam actor {
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam usecase {
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
left to right direction
skinparam nodesep 25
skinparam ranksep 90

actor "Administrador" as ADM
actor "Ingeniero de obra" as ING

rectangle "Ctrl+" {
  package "ERP" {
    usecase "CU-01 Gestionar obra" as CU01
    usecase "CU-02 Mantener catálogos" as CU02
    usecase "CU-06 Registrar contrato\nde subcontratista" as CU06
    usecase "CU-10 Gestionar la documentación\nde la obra" as CU10
    usecase "CU-11 Importar la carpeta\nexistente de la obra" as CU11
  }
  package "ECMS" {
    usecase "CU-03 Cargar el presupuesto\ndel cliente" as CU03
    usecase "CU-04 Validar y finalizar el\npresupuesto del cliente" as CU04
    usecase "CU-05 Armar y versionar el\npresupuesto de costos" as CU05
    usecase "CU-07 Medir el avance\ndel certificado" as CU07
    usecase "CU-09 Liquidar subcontratista" as CU09
    usecase "CU-12 Publicar y revisar una\nversión de modelo" as CU12
    usecase "CU-13 Calcular el cómputo\ndel modelo" as CU13
    usecase "CU-14 Vincular la estructura de trabajo\ncon el modelo y los documentos" as CU14
    usecase "CU-15 Abrir, asignar y cerrar\nuna incidencia" as CU15
    usecase "CU-16 Consultar el tablero y\nla actividad de la obra" as CU16
  }
  package "Motor de finanzas" {
    usecase "CU-08 Calcular el certificado" as CU08
  }
}

ADM -- CU01
ADM -- CU02
ADM -- CU06
ADM -- CU10
ADM -- CU11
ADM -- CU12
ADM -- CU14
ADM -- CU15
ADM -- CU16

ING -- CU03
ING -- CU04
ING -- CU05
ING -- CU07
ING -- CU08
ING -- CU09
ING -- CU10
ING -- CU12
ING -- CU13
ING -- CU14
ING -- CU15
ING -- CU16

@enduml
