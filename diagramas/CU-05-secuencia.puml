@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-05 · Armar y versionar el presupuesto de costos
actor "Ingeniero de obra" as Ing
box "ECMS" #EAF2F6
participant "costos:\nPresupuestoCostos" as PC
participant "cliente:\nPresupuestoCliente" as Cli
participant "anterior:\nVersionCostos" as Ant
participant "version:\nVersionCostos" as V
participant "gg:\nRubro" as GG
participant "item:\nItem" as Item
end box

Ing -> PC: consultarVersiones()
PC --> Ing: versiones con su estado, vigente e históricas (RF-06)

alt primera versión, tal como sale del presupuesto del cliente (1c, paso 2)
  Ing -> PC: guardarPrimeraVersión(cliente, actor)
  create V
  PC -> V: «create»(número = 1, estado = vigente, actor)
  PC -> V: copiarRubros(cliente)
  V -> Cli: obtenerRubros()
  Cli --> V: rubros e ítems con su código estable
  PC -> V: agregarRubroGastosGenerales()
  create GG
  V -> GG: «create»("Gastos generales de obra")
  PC --> Ing: versión 1 vigente, con actor y fecha
else versión siguiente, con cambios de cantidad o ubicación (1c)
  Ing -> PC: guardarVersión(cambios, motivo, actor)
  PC -> PC: obtenerVigente()
  PC -> Ant: difiereDe(cambios)
  Ant --> PC: distinta: lógico
  break nada de lo que se guarda deja la vigente distinta (6a)
    PC --> Ing: lo informa; no crea otra versión y la vigente no cambia
  end
  critical guardado atómico (NF-02)
    create V
    PC -> V: «create»(número, anterior, motivo, actor)
    PC -> V: copiarDe(anterior)
    loop por cada cambio
      alt cambio de cantidad
        V -> Item: cambiarCantidad(cantidad)
      else cambio de ubicación
        V -> Item: moverA(rubro)
      end
    end
    PC -> Ant: pasarAHistórica()
    break falla el guardado (NF-02)
      PC --> Ing: revierte; la vigente no cambia
    end
  end
  PC --> Ing: versión vigente con actor, fecha y motivo;\nla anterior queda histórica (RF-05, RF-06)
end

note over PC, Item
  Cada versión se guarda entera, en un paso, y conserva el código
  estable de sus ítems. Vincular un ítem (CU-14) no crea una versión.
end note
@enduml
