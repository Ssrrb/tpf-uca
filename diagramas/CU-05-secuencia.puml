@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam BoxPadding 6
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ActorBackgroundColor #F5F8FA
skinparam ArrowColor #17324D
skinparam SequenceBoxBorderColor #17324D
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
hide footbox
title CU-05 · Mantener catálogos y banco de insumos
actor "Administrador" as Admin
box "ERP" #EAF2F6
participant "catalogo:\nCatalogo" as Cat
participant "insumo:\nInsumo" as Ins
participant "recurso:\nRecurso" as Rec
participant "precioActual:\nPrecio" as PAct
participant "precioNuevo:\nPrecio" as PNue
end box

Admin -> Cat: listar(filtro)
Cat --> Admin: lista paginada por código, nombre y rubro

alt crear un recurso (paso 3)
  Admin -> Cat: crearRecurso(datos)
  Cat -> Cat: códigoDisponible(código)
  break el código ya existe (5a)
    Cat --> Admin: pide otro código (vuelve al paso 3)
  end
  create Ins
  Cat -> Ins: «create»(código, descripción, unidad, categoría)
  Admin -> Ins: registrarPrecio(valor, vigenteDesde)
  create PNue
  Ins -> PNue: «create»(valor, vigenteDesde)
else modificar un recurso (3a)
  Admin -> Rec: modificar(datos)
else dar de baja un recurso (3b)
  Admin -> Rec: darDeBaja(actor)
  note right of Rec
    Inactivo: no se ofrece en cargas nuevas
    y se conserva en lo ya registrado.
  end note
else actualizar un precio (4a)
  Admin -> Ins: registrarPrecio(valor, vigenteDesde)
  Ins -> Ins: obtenerPrecioVigente(vigenteDesde)
  Ins -> PAct: seSuperpone(vigenteDesde)
  PAct --> Ins: superpone: lógico
  break la vigencia se superpone con otro precio (5b)
    Ins --> Admin: rechaza; indica la vigencia en conflicto
  end
  Ins -> PAct: cerrarVigencia(vigenteDesde - 1 día)
  create PNue
  Ins -> PNue: «create»(valor, vigenteDesde)
end
Ins --> Admin: recurso y precio vigente guardados con actor y fecha
@enduml
