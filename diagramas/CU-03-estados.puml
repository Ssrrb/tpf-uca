@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-03 · Estados de la Versión del presupuesto de costos
state "Propuesta" as propuesta
state "Vigente" as vigente
state "Histórica" as historica
state "Descartada" as descartada

[*] --> propuesta : crearPrimeraVersión() o crearVersiónCorrectiva(motivo)
propuesta --> propuesta : completarÍtem(ítem, ejecutor, acu)
propuesta --> vigente : activar(versión, actor) [datos válidos] / marcarVigente(actor)
propuesta --> descartada : cancelar()
vigente --> vigente : completarÍtem(ítem, ejecutor, acu) [ítem no certificado]
vigente --> historica : activar(otra versión) / pasarAHistórica()
historica --> [*]
descartada --> [*]

note right of historica
  Sigue consultable con los certificados
  que la usaron (NF-04).
end note
@enduml
