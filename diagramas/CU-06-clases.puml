@startuml
!theme plain
skinparam style strictuml
title CU-06 · Generar versión del certificado de avance
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ECMS" {
  class "Certificado de avance" as Certificado {
    --
    + generarVersiónSiguiente(actor): VersiónCertificado
    + últimaVersión(): VersiónCertificado [0..1]
  }

  class "Versión del certificado" as VersionCertificado {
    número: entero
    bruto: guaraníes
    amortizaciónAnticipo: guaraníes
    fondoReparo: guaraníes
    neto: guaraníes
    iva: guaraníes
    guardadaPor: Usuario [0..1]
    fecha: fecha y hora [0..1]
    --
    + agregarLíneaAjuste(versiónCorregida, cantidad, importe, motivo): vacío
    + tomarCantidades(): vacío
    + calcularImportes(): vacío
    + señalar(): lista de Señalamiento
    + guardar(actor): vacío
    + exportar(formato: XLSX | PDF): archivo
  }

  class "Línea del certificado" as LineaCertificado {
    tipo: cantidad | ajuste
    cantidad: decimal
    precioUnitario: guaraníes
    importe: guaraníes
    avanceAnterior: decimal
    /acumulado: decimal
    motivo: texto [0..1]
    --
    + valorizar(precio: guaraníes): guaraníes
  }

  class "Medición" as Medicion {
    cantidad: decimal
    --
    + cantidadNoCertificada(): decimal
    + marcarCertificada(versión): vacío
  }

  class "Saldo del ítem" as SaldoItem {
    /saldoContractual: decimal
    --
    + saldoContractual(): decimal
    + registrarCertificado(cantidad): vacío
  }

  class "Presupuesto del cliente" as PresupuestoCliente {
    --
    + precioUnitario(ítem): guaraníes [0..1]
  }

  class "Presupuesto de adendas" as PresupuestoAdendas {
    --
    + precioVigente(ítem, fecha): guaraníes [0..1]
  }

  class "Señalamiento" as Senalamiento {
    tipo: exceso | medición faltante | precio sin movimiento\n | diferencia de totales | mayor costo
    datoOrigen: texto
  }
}

package "ERP" {
  class Obra {
    estado: EstadoObra
    porcentajeIVA: decimal
    porcentajeFondoReparo: decimal
    --
    + permiteCertificar(): lógico
  }

  class Anticipo {
    saldoPorAmortizar: guaraníes
    --
    + amortizar(bruto: guaraníes): guaraníes
  }
}

Certificado "0..1" --> "1" Obra : de la obra
Certificado "1" *-- "0..*" VersionCertificado : versiones numeradas
VersionCertificado "0..1" --> "0..1" VersionCertificado : anterior
VersionCertificado "1" *-- "1..*" LineaCertificado : líneas
LineaCertificado "0..1" --> "0..*" Medicion : certifica
LineaCertificado "0..*" --> "0..1" VersionCertificado : ajuste de
LineaCertificado "0..*" --> "1" SaldoItem : ítem
VersionCertificado "0..*" --> "1" PresupuestoCliente : precios
VersionCertificado "0..*" --> "0..1" PresupuestoAdendas : precios de adendas
VersionCertificado "1" *-- "0..*" Senalamiento : señala
VersionCertificado "0..*" --> "0..1" Anticipo : amortiza

note bottom of VersionCertificado
  Orden de cálculo (RN-08): bruto, amortización del anticipo,
  fondo de reparo, neto e IVA, en guaraníes enteros
  redondeados por línea (RN-09).
  Guardada, no se modifica ni se reemplaza (RN-06).
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
