@startuml
!theme plain
skinparam style strictuml
title CU-06 · Calcular el certificado y el consumo de recursos
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "Motor de finanzas" {
  class "Cálculo del certificado" as CalculoCertificado {
    --
    + calcularVersión(versión, actor): vacío
    + confirmar(versión, actor): vacío
  }
}

package "ECMS" {
  class "Versión del certificado" as VersionCertificado {
    número: entero
    estado: cantidades cerradas | valorizada
    bruto: guaraníes
    amortizaciónAnticipo: guaraníes
    fondoReparo: guaraníes
    neto: guaraníes
    iva: guaraníes
    guardadaPor: Usuario [0..1]
    --
    + estaCerrada(): lógico
    + agregarLíneaAjuste(versiónCorregida, cantidad, importe, motivo): vacío
    + agregarLíneaRegularización(ítem, cantidad, precio): vacío
    + registrarImportes(bruto, amortización, fondoReparo, neto, iva): vacío
    + guardar(actor): vacío
  }

  class "Línea del certificado" as LineaCertificado {
    tipo: cantidad | ajuste | regularización
    cantidad: decimal
    precioUnitario: guaraníes
    importe: guaraníes
    exceso: guaraníes [0..1]
    --
    + valorizar(precio: guaraníes): guaraníes
    + señalarExceso(montoContractual: guaraníes): guaraníes [0..1]
  }

  class "Medición" as Medicion {
    cantidad: decimal
    --
    + insumosConsumidos(): lista de Insumo
    + marcarCertificada(versión): vacío
  }

  class "Saldo del ítem" as SaldoItem {
    certificada: decimal
    exceso: guaraníes
    --
    + registrarCertificado(cantidad): vacío
    + montoContractual(): guaraníes
    + registrarExceso(importe): vacío
    + regularizarExceso(importe): vacío
  }

  class "Presupuesto del cliente" as PresupuestoCliente {
    --
    + precioUnitario(ítem): guaraníes [0..1]
  }

  class "Apartado Adendas" as ApartadoAdendas {
    --
    + ítemsAprobadosDesde(versión): lista de ItemAdenda
    + precioAprobado(ítem): guaraníes [0..1]
  }
}

package "ERP" {
  class Obra {
    estado: EstadoObra
    porcentajeIVA: decimal
    porcentajeFondoReparo: decimal
    --
    + permiteCertificar(): lógico
  }

  class Anticipo {
    saldoPorAmortizar: guaraníes
    --
    + amortizar(bruto: guaraníes): guaraníes
  }

  class Insumo {
    código: texto
    --
    + precioVigente(fecha): guaraníes [0..1]
  }

  class "Consumos de la obra" as ConsumosObra {
    consumos: lista de Insumo
    --
    + prepararConsumo(insumo, cantidad, precio, medición): vacío
    + registrar(versión): vacío
  }
}

CalculoCertificado ..> VersionCertificado : <<use>>
CalculoCertificado ..> ConsumosObra : <<use>>
VersionCertificado "1" *-- "1..*" LineaCertificado : líneas
LineaCertificado "0..1" --> "0..*" Medicion : certifica
LineaCertificado "0..*" --> "1" SaldoItem : ítem
VersionCertificado "0..*" --> "1" PresupuestoCliente : precios
VersionCertificado "0..*" --> "0..1" ApartadoAdendas : adendas registradas
ApartadoAdendas ..> SaldoItem : suma al monto contractual
VersionCertificado "0..*" --> "0..1" Anticipo : amortiza
VersionCertificado "0..*" --> "1" Obra : de la obra
Obra "1" *-- "1" ConsumosObra : consumos
ConsumosObra "0..*" --> "0..*" Insumo : registra el consumo de

note bottom of VersionCertificado
  Orden de cálculo (RF-10): bruto, amortización del anticipo,
  fondo de reparo, neto e IVA, en guaraníes enteros
  redondeados por línea (NF-05).
  Guardada, no se modifica: se corrige con líneas
  de ajuste en la versión siguiente (RF-09).
  Exceso: el monto acumulado de un ítem supera el del
  cliente más sus adendas registradas, por la causa que sea.
  Queda fuera del bruto como saldo negativo; lo que una
  adenda aprueba entra como línea de regularización en
  la versión siguiente y el resto es exceso no reconocido (RF-08).
end note

legend bottom
  Línea con punta abierta = asociación dirigida. Rombo relleno = composición.
  Triángulo hueco = generalización. Discontinua con punta abierta = dependencia.
  1 = exactamente uno; 0..1 = opcional; 0..* = cero o muchos.
endlegend
@enduml
