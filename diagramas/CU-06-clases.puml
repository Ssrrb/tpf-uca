@startuml
!theme plain
skinparam style strictuml
title CU-06 · Registrar contrato de subcontratista
hide circle
hide empty methods
hide empty fields
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
package "ERP" {
  class Obra {
    código: texto
    --
    + númeroContratoDisponible(número): lógico
    + registrarContrato(subcontratista, número, fechas, archivo): Contrato
  }

  class Proveedor {
    ruc: texto
    tipo: texto
    --
    + esSubcontratista(): lógico
  }

  class Contrato {
    número: texto
    fechaInicio: fecha
    fechaFin: fecha
    archivo: Archivo
    impuestos: decimal
    porcentajeFondoReparo: decimal
    registradoPor: Usuario
    fecha: fecha y hora
    --
    + validarArchivo(): lógico
    + agregarÍtem(ítem, cantidad, precio, límite): vacío
    + configurarCondiciones(impuestos, retenciones, fondoReparo): vacío
    + confirmar(actor): vacío
  }

  class "Ítem del contrato" as ItemContrato {
    cantidad: decimal
    precio: guaraníes
    límite: decimal
  }

  class "Retención" as Retencion {
    tipo: IVA | renta
    porcentaje: decimal
  }
}

package "ECMS" {
  class "Saldo del ítem" as SaldoItem {
    cantidadVigente: decimal
    asignadaAContratos: decimal
    --
    + cantidadVigente(): decimal
    + disponibleParaContratos(): decimal
    + reservarParaContrato(cantidad): vacío
  }

  class "Ítem" as Item {
    código: texto {estable}
  }
}

Obra "1" *-- "0..*" Contrato : subcontratos
Contrato "0..*" --> "1" Proveedor : con
Contrato "1" *-- "1..*" ItemContrato : alcance
ItemContrato "0..*" --> "1" Item : ítem
Item "1" *-- "1" SaldoItem : saldo
Contrato "0..*" --> "0..*" Retencion : aplica

note bottom of SaldoItem
  El ECMS lleva el saldo de cada ítem y el ERP lo consulta:
  la cantidad del contrato no pasa la de la vigente y ninguna
  cantidad se asigna a dos contratos (RF-08). El límite no se
  valida contra el costo: queda como lo escribe el Administrador.
end note

@enduml
