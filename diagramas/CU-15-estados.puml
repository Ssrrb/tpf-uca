@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-15 · Estados del Presupuesto de adendas del cliente
state "En carga" as en_carga
state "Cargado" as cargado
state "Descartado" as descartado

[*] --> en_carga : crear(número, fecha)
en_carga --> en_carga : importar(archivo) / agregarLínea(...)
en_carga --> cargado : guardar(actor) [datos completos y número único]
en_carga --> descartado : cancelar()
cargado --> [*]
descartado --> [*]

note right of cargado
  No se modifica: un cambio del cliente
  se carga como otro presupuesto (RF-06).
  Sus líneas se aprueban en CU-11.
end note
@enduml
