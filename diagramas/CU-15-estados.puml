@startuml
!theme plain
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #17324D
skinparam activity {
  StartColor #17324D
  EndColor #17324D
  BarColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
  DiamondBackgroundColor #EAF2F6
  DiamondBorderColor #17324D
}
skinparam swimlane {
  BorderColor #17324D
  TitleBackgroundColor #EAF2F6
}
skinparam state {
  StartColor #17324D
  EndColor #17324D
  BackgroundColor #F5F8FA
  BorderColor #17324D
}
skinparam package {
  BackgroundColor #EAF2F6
  BorderColor #17324D
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
title CU-15 · Estados de la Versión del presupuesto de adendas
state "En edición" as en_edicion
state "Vigente" as vigente
state "Anterior" as anterior
state "Descartada" as descartada

[*] --> en_edicion : emitirVersión(actor) / armar(adendas)
en_edicion --> en_edicion : corregirLínea(línea, descripción, motivo)
en_edicion --> vigente : guardar(actor) [motivos completos] / activar(versión)
en_edicion --> descartada : cancelar()
vigente --> anterior : activar(otra versión) / pasarAAnterior()
anterior --> [*]
descartada --> [*]

note right of anterior
  Sigue consultable y exportable (1a).
end note
@enduml
