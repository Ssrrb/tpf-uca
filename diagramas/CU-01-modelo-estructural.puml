@startuml
!theme plain
skinparam style strictuml
title CU-01 · Crear obra y asignar responsables
left to right direction
hide circle
hide empty methods
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #167C80
skinparam class {
  BackgroundColor #F5F8FA
  BorderColor #17324D
  HeaderBackgroundColor #EAF2F6
}

class Usuario {
  nombre: texto [opcional]
  correo: texto
  --
  + obtenerMembresía(organización): Membresía [opcional]
}

class "Organización" as Organizacion {
  nombre: texto
  --
  + códigoDisponible(código): lógico
  + crearObra(datos, creador): Obra
}

class "Membresía" as Membresia {
  rol: texto
  --
  + obtenerRol(): texto
}

class Obra {
  código: texto
  nombre: texto
  dirección: texto [opcional]
  estado: planificada | activa | pausada | cerrada
  fechaInicio: fecha [opcional]
  fechaFin: fecha [opcional]
  --
  + validarDatos(): lógico
  + asignarResponsable(usuario, registradoPor): Asignación
}

class "Asignación de responsable" as Asignacion {
  fechaAsignación: fecha y hora
  --
  + obtenerResponsable(): Usuario
}

Membresia "0..*" --> "1" Usuario : corresponde a
Membresia "0..*" --> "1" Organizacion : pertenece a
Obra "0..*" --> "1" Organizacion : pertenece a
Obra "0..*" --> "1" Usuario : creada por
Asignacion "0..*" --> "1" Obra : corresponde a
Asignacion "0..*" --> "1" Usuario : asigna a

note bottom of Obra
  Código único por organización.
  Si ambas fechas existen: fechaFin >= fechaInicio.
end note

note bottom of Membresia
  Un usuario tiene una membresía por organización.
  El rol pertenece a la organización, no a la obra.
end note

note bottom of Asignacion
  Un usuario puede asignarse una sola vez a cada obra.
end note

legend bottom
  --> Asociación dirigida hacia la entidad referenciada.
  1 = exactamente uno; 0..* = cero o muchos.
  Se omiten identificadores y campos técnicos.
endlegend
@enduml
