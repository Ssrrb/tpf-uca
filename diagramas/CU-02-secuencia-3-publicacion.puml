@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam sequenceMessageAlign center
skinparam maxMessageSize 210
skinparam ParticipantPadding 8
skinparam ParticipantBackgroundColor #F5F8FA
skinparam ParticipantBorderColor #17324D
skinparam ActorBorderColor #17324D
skinparam ArrowColor #17324D
hide footbox
title CU-02 · 3/3 · Comparación y publicación
actor "Ingeniero de obra" as Usuario
participant "presupuesto:\nPresupuesto" as Presupuesto
participant "version:\nVersionPresupuesto" as Version
participant "rubro:\nRubro" as Rubro
participant "item:\nItemPresupuesto" as Item
note over Usuario, Item
  Inicio: estructura confirmada y datos válidos (2/3).
  Se continúa sobre la misma versión del presupuesto.
end note
== Recálculo y comparación ==
Usuario -> Version: recalcularTotales()
loop Por cada rubro, desde los subrubros hacia sus padres
  Version -> Rubro: recalcularTotal()
  loop Por cada ítem directo del rubro
    Rubro -> Item: recalcularTotal()
    Item --> Rubro: totalRecalculado: decimal
  end
  note over Rubro, Item
    Suma ítems directos y subrubros sin duplicarlos.
    Actualiza totalRecalculado.
  end note
  Rubro --> Version: totalRecalculado: decimal
end
note over Presupuesto, Version
  Suma rubros raíz y actualiza totalRecalculado.
  Usa moneda y redondeo del presupuesto.
end note
Version --> Usuario: totalRecalculado: decimal

Usuario -> Version: compararTotales()
loop Por cada rubro y subrubro
  Version -> Rubro: compararTotal()
  Rubro --> Version: comparación: texto
  loop Por cada ítem del rubro
    Version -> Item: compararTotal()
    Item --> Version: comparación: texto
  end
end
note over Version, Item
  /diferenciaTotal = totalRecalculado - totalDeclarado.
  Si falta alguno de los valores, no se calcula la diferencia.
end note
Version --> Usuario: comparación de totales: texto

== Aceptación y publicación ==
alt El usuario rechaza el resultado o no acepta las diferencias existentes
  Usuario -> Version: cancelar()
  note over Presupuesto, Version: La versión no se publica.
else El usuario acepta el resultado y las diferencias, si existen
  Usuario -> Version: aceptarResultado(aceptarDiferencias)
  note over Presupuesto, Version
    diferenciasAceptadas registra la decisión.
    Aceptar exige estructuraConfirmada y datos válidos;
    si existen diferencias, aceptarDiferencias = verdadero.
  end note
  Usuario -> Presupuesto: publicarVersion(version)
  note over Presupuesto, Version
    La publicación completa deja version disponible y conserva las anteriores.
    Presupuesto.total toma version.totalRecalculado.
    revisionPublicada registra la revision resultante del presupuesto.
    Una falla o interrupción descarta la carga incompleta mediante
    descartarCargaIncompleta() y mantiene la versión anterior disponible.
  end note
end


@enduml
